---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';

const options = [
  {
    id: 'A',
    name: 'Specification sheet',
    href: '/options/a/',
    summary: 'Navy banner with an "At a glance" panel beside the heading. The page reads like a capability statement: numbered sections, hairline rules and a white RFQ process sheet that overlaps the navy government band.',
    best: 'A balanced, structured first impression. Navy and white share the page evenly.',
    points: ['"At a glance" panel answers who, what and how in the first screen', 'Government section on a navy band with the eight steps in two columns', 'Capabilities as a two-column ruled list'],
  },
  {
    id: 'B',
    name: 'Editorial',
    href: '/options/b/',
    summary: 'White-led and quieter. A large navy heading with a red rule sits beside a tall photo. A section index under the banner lets a contracting officer jump straight to what they need.',
    best: 'A premium, document-like feel, and making the most of Exron\'s own photography.',
    points: ['Large photo in the banner (Exron\'s own photo once supplied)', 'Vertical RFQ timeline next to a sample quotation', 'Capabilities as a specification table with a navy header row'],
  },
  {
    id: 'C',
    name: 'Command',
    href: '/options/c/',
    summary: 'Navy-led and bolder. A full-height navy banner with a "Start an RFQ" box, followed by a band of key figures taken from the content. Strong contrast between dark and light sections.',
    best: 'The strongest, most authoritative impression, and the fastest route to an RFQ.',
    points: ['Short RFQ box in the banner that carries over to the full form', 'Figures band: 2 divisions, 10 categories, 8-step process, Middle East market', 'Eight RFQ steps in a dark grid, experience in a split navy panel'],
  },
];
---
<BaseLayout title="Homepage options | Exron Global" description="Three homepage design directions for Exron Global to choose from." noindex>
  <PageHead
    eyebrow="For review · not public"
    title="Homepage options"
    summary="Three design directions for the homepage. Each one uses the same approved text, colors, logo and rules. Only the layout and emphasis change. Please choose one, or tell us which parts of each you prefer."
  />
  <section class="section">
    <div class="container">
      <ol class="opts">
        {options.map((o) => (
          <li class="opt">
            <p class="opt__id mono">Option {o.id}</p>
            <h2>{o.name}</h2>
            <p>{o.summary}</p>
            <p class="opt__best"><strong>Best for:</strong> {o.best}</p>
            <ul>{o.points.map((p) => <li>{p}</li>)}</ul>
            <a class="btn btn--primary" href={o.href}>View option {o.id}</a>
          </li>
        ))}
      </ol>
      <p class="small opts__note">
        All three keep the same content order (sections 01 to 10), the RFQ form, the disclosure lines and the footer disclaimer.
        Highlighted boxes mark information Exron Global still needs to confirm.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .opts { list-style: none; display: grid; gap: 1.5rem; }
  @media (min-width: 1024px) { .opts { grid-template-columns: repeat(3, 1fr); } }
  .opt { display: flex; flex-direction: column; padding: 1.75rem; border: 1px solid var(--rule); border-top: 4px solid var(--navy); }
  .opt__id { margin: 0 0 0.5rem; font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--red); }
  .opt h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .opt__best { color: var(--navy); }
  .opt ul { margin: 0 0 1.5rem 1.1rem; display: grid; gap: 0.4rem; }
  .opt .btn { margin-top: auto; align-self: flex-start; }
  .opts__note { margin-top: 2rem; color: var(--steel); }
</style>
