---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptionBar from '../../components/OptionBar.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import QuoteSheet from '../../components/QuoteSheet.astro';
import { home, site, rich, resolveImage } from '../../lib/content';

const { hero, strip, intro, government: gov, capabilities: caps, experience: exp, why, coverage, commercial, group, cta } = home;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const taglineParts = String(hero.tagline).split(/(?<=\.)\s+/);

const heroImage = resolveImage(hero.image);
const heroBg = heroImage ? await getImage({ src: heroImage, width: 1920, format: 'webp' }) : undefined;

// Counts come from the content itself, so they stay true when the content changes.
const figures = [
  { value: '2', label: 'Divisions: government first, commercial second' },
  { value: String(caps.items.length), label: 'Supply categories quoted in one response' },
  { value: String(gov.steps.length), label: 'Steps from RFQ to proof of delivery' },
  { value: 'Middle East', label: 'Primary market, with international coverage' },
];
---
<BaseLayout title="Homepage option C | Exron Global" description={home.seo.description} noindex>
  <OptionBar slot="top" current="C" />
  {heroBg && <link slot="head" rel="preload" as="image" href={heroBg.src} fetchpriority="high" />}

  <!-- 01 Hero: full navy, quick RFQ start -->
  <section class="c-hero on-navy" aria-labelledby="c-hero-title" style={heroBg ? `--hero-img:url(${heroBg.src})` : undefined}>
    {heroBg && <div class="c-hero__img" role="img" aria-label={hero.image_alt}></div>}
    <div class="container c-hero__grid">
      <div>
        <p class="c-eyebrow mono">{hero.eyebrow}</p>
        <h1 id="c-hero-title">{hero.title}</h1>
        <ul class="c-tagline">
          {taglineParts.map((t: string, i: number) => <li><span class="mono">{pad(i)}</span>{t}</li>)}
        </ul>
        <p class="c-hero__text">{hero.text}</p>
        <a class="text-link" href="#c-caps">{hero.secondary_label} <span aria-hidden="true">→</span></a>
      </div>

      <form class="c-start" action="/submit-rfq/" method="get" aria-labelledby="c-start-title">
        <p class="c-start__label mono">RFQ intake</p>
        <h2 id="c-start-title">Start an RFQ</h2>
        <p class="c-start__intro" set:html={rich(`Three details now, the rest on the next page. Every request is acknowledged ${site.rfq_acknowledgment}.`)} />
        <label for="c-org">Organization</label>
        <input id="c-org" name="organization" type="text" maxlength="200" autocomplete="organization" />
        <label for="c-email">Official email</label>
        <input id="c-email" name="email" type="email" maxlength="200" autocomplete="email" />
        <label for="c-sol">RFQ or solicitation number <span class="c-opt">(if you have one)</span></label>
        <input id="c-sol" name="solicitation_number" type="text" maxlength="100" class="mono" />
        <button class="btn btn--primary" type="submit">{hero.primary_label} <span aria-hidden="true">→</span></button>
      </form>
    </div>
    {!heroBg && <p class="container c-hero__note mono">{hero.image_note}</p>}
  </section>

  <!-- Key figures (all derived from the content) -->
  <section class="c-figures on-navy" aria-label="Exron Global in figures">
    <dl class="container c-figures__grid">
      {figures.map((f) => <div><dt>{f.label}</dt><dd class:list={['mono', !/^\d+$/.test(f.value) && 'is-text']}>{f.value}</dd></div>)}
    </dl>
  </section>

  <!-- 02 Intro -->
  <section class="section" aria-labelledby="c-intro-title">
    <div class="container c-intro">
      <div>
        <p class="c-num mono">02 · Who we are</p>
        <h2 id="c-intro-title">{intro.title}</h2>
        <p class="c-intro__hq mono"><span>{intro.facts[0].label}</span> <span set:html={rich(intro.facts[0].value)} /></p>
      </div>
      <p class="lead c-intro__text" set:html={rich(intro.text)} />
    </div>
  </section>

  <!-- 03 Government: dark, grid of steps -->
  <section class="c-gov on-navy" id="c-gov" aria-labelledby="c-gov-title">
    <div class="container">
      <div class="c-gov__top">
        <div>
          <p class="c-num c-num--light mono">03 · {gov.eyebrow}</p>
          <h2 id="c-gov-title">{gov.title}</h2>
          <p class="lead">{gov.lead}</p>
          <a class="text-link" href="/government-contracting/">{gov.link_label} <span aria-hidden="true">→</span></a>
        </div>
        <QuoteSheet />
      </div>
      <h3 class="c-gov__steps-title">{gov.steps_title}</h3>
      <ol class="c-steps">
        {gov.steps.map((s: any, i: number) => (
          <li>
            <span class="c-steps__num mono" aria-hidden="true">{pad(i)}</span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="c-strip">
    <div class="container c-strip__inner">
      <p set:html={rich(strip.text)} />
      <a class="btn btn--primary" href="/submit-rfq/">{strip.link_label}</a>
    </div>
  </div>

  <!-- 04 Capabilities: flat ruled cells -->
  <section class="section" id="c-caps" aria-labelledby="c-caps-title">
    <div class="container">
      <p class="c-num mono">04 · Capabilities</p>
      <h2 id="c-caps-title">{caps.title}</h2>
      <p class="lead c-sub">{caps.intro}</p>
      <ul class="c-caps">
        {caps.items.map((c: any, i: number) => (
          <li>
            <span class="mono">{pad(i)}</span>
            <h3>{c.name}</h3>
            <p>{c.examples}</p>
          </li>
        ))}
      </ul>
      <div class="c-row">
        <p class="small">{caps.footnote}</p>
        <a class="text-link" href="/capabilities/">{caps.link_label} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 05 Experience: split panel -->
  <section class="c-exp" aria-labelledby="c-exp-title">
    <div class="c-exp__panel on-navy">
      <p class="c-num c-num--light mono">05 · {exp.eyebrow}</p>
      <h2 id="c-exp-title">{exp.title}</h2>
    </div>
    <div class="c-exp__body">
      {exp.body.map((p: string, i: number) => <p class:list={[i === 0 && 'lead']} set:html={rich(p)} />)}
      <p class="small c-disclosure"><strong>Disclosure.</strong> {exp.disclosure}</p>
    </div>
  </section>

  <!-- 06 Why -->
  <section class="section" aria-labelledby="c-why-title">
    <div class="container">
      <p class="c-num mono">06 · Why Exron Global</p>
      <h2 id="c-why-title" class="c-why-title">{why.title}</h2>
      <ol class="c-why">
        {why.items.map((w: any, i: number) => (
          <li>
            <span class="mono">{pad(i)}</span>
            <div>
              <h3>{w.claim.replace(/\.$/, '')}</h3>
              <p set:html={rich(w.detail)} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 Coverage -->
  <section class="section c-cov on-navy" aria-labelledby="c-cov-title">
    <div class="container c-cov__grid">
      <div>
        <p class="c-num c-num--light mono">07 · Coverage</p>
        <h2 id="c-cov-title">{coverage.title}</h2>
        <p class="c-muted" set:html={rich(coverage.text)} />
      </div>
      <div class="c-cov__lists">
        <div>
          <h3 class="c-label mono">{coverage.deliver_title}</h3>
          <ul>{coverage.deliver.map((c: string) => <li set:html={rich(c)} />)}</ul>
        </div>
        <div>
          <h3 class="c-label mono">{coverage.source_title}</h3>
          <ul>{coverage.source.map((c: string) => <li set:html={rich(c)} />)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 Commercial -->
  <section class="section" aria-labelledby="c-com-title">
    <div class="container c-com">
      <div>
        <p class="c-num mono">08 · {commercial.eyebrow}</p>
        <h2 id="c-com-title">{commercial.title}</h2>
        <p>{commercial.text}</p>
        <ul class="c-com__list">{commercial.sectors.map((s: string) => <li>{s}</li>)}</ul>
        <a class="btn btn--secondary" href="/submit-rfq/?division=commercial">{commercial.button_label}</a>
      </div>
      <PhotoSlot image={commercial.image} alt={commercial.image_alt} note={commercial.image_note} ratio="4 / 3" />
    </div>
  </section>

  <!-- 09 Group -->
  <section class="section section--paper" aria-labelledby="c-group-title">
    <div class="container c-group">
      <div>
        <p class="c-num mono">09 · Group affiliation</p>
        <h2 id="c-group-title">{group.title}</h2>
      </div>
      <p set:html={rich(group.text)} />
    </div>
  </section>

  <!-- 10 CTA -->
  <section class="section c-cta on-navy" aria-labelledby="c-cta-title">
    <div class="container c-cta__grid">
      <div>
        <p class="c-num c-num--light mono">10 · Request a quotation</p>
        <h2 id="c-cta-title">{cta.title}</h2>
        <p class="lead c-muted">{cta.text}</p>
        <div class="c-actions">
          <a class="btn btn--primary" href="/submit-rfq/">{cta.primary_label}</a>
          <a class="btn btn--secondary" href="/contact/">{cta.secondary_label}</a>
        </div>
      </div>
      <p class="small c-cta__notice"><strong>Secure transmission.</strong> {site.secure_notice}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .c-num { margin: 0 0 1rem; font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--red); }
  .c-num--light { color: var(--on-navy-muted); }
  .c-muted { color: var(--on-navy-muted); }
  .c-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .on-navy h2, .on-navy h3, .on-navy h4 { color: #fff; }

  /* Hero */
  .c-hero { position: relative; background: var(--navy-deep); color: #fff; overflow: hidden; }
  .c-hero__img { position: absolute; inset: 0; background: var(--hero-img) center / cover no-repeat; }
  .c-hero__img::after { content: ''; position: absolute; inset: 0; background: rgba(42, 41, 80, 0.66); }
  .c-hero__grid { position: relative; display: grid; gap: 3rem; padding-block: clamp(3rem, 2rem + 6vw, 7rem) 3rem; align-items: center; }
  @media (min-width: 1024px) { .c-hero__grid { grid-template-columns: 7fr 4fr; gap: 4rem; min-height: min(78vh, 760px); } }
  .c-eyebrow { margin: 0 0 1.25rem; font-size: 0.875rem; letter-spacing: 0.24em; color: var(--on-navy-muted); }
  .c-hero h1 { color: #fff; font-size: clamp(2.125rem, 1.4rem + 2.5vw, 3.5rem); line-height: 1.06; max-width: 22ch; }
  .c-tagline { list-style: none; margin: 2rem 0 0; display: grid; gap: 0.35rem; border-left: 3px solid var(--red); padding-left: 1rem; }
  .c-tagline li { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 650; font-size: var(--step-1); }
  .c-tagline .mono { font-size: 0.875rem; color: var(--on-navy-muted); margin-right: 0.75rem; font-weight: 400; }
  .c-hero__text { margin: 1.5rem 0 1.5rem; color: var(--on-navy-muted); max-width: 58ch; }
  .c-hero__note { position: relative; margin: 0 auto; padding-bottom: 1rem; font-size: 0.8125rem; color: var(--on-navy-muted); }

  .c-start { background: var(--white); color: var(--ink); padding: 1.75rem; border-top: 5px solid var(--red); display: grid; gap: 0.4rem; }
  .c-start__label { margin: 0; font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .c-start h2 { color: var(--navy) !important; font-size: var(--step-3); }
  .c-start__intro { margin: 0.25rem 0 0.75rem; font-size: 1rem; color: var(--steel); }
  .c-start label { font-weight: 650; margin-top: 0.5rem; }
  .c-opt { font-weight: 400; color: var(--steel); }
  .c-start input { min-height: 48px; padding: 0.6rem 0.8rem; font: inherit; border: 1px solid #8b8e9c; border-radius: var(--radius); }
  .c-start input.mono { font-family: var(--font-mono); }
  .c-start input:focus-visible { outline: 3px solid var(--navy); outline-offset: 0; }
  .c-start .btn { margin-top: 1rem; width: 100%; }

  /* Figures */
  .c-figures { background: var(--navy); border-top: 1px solid var(--rule-on-navy); }
  .c-figures__grid { margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; }
  .c-figures__grid > div { display: flex; flex-direction: column-reverse; gap: 0.35rem; padding: 1.5rem 1rem 1.5rem 0; border-bottom: 1px solid var(--rule-on-navy); }
  .c-figures dd { margin: 0; font-size: clamp(2rem, 1.5rem + 2vw, 3rem); font-weight: 500; color: #fff; line-height: 1; }
  .c-figures dd.is-text { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 700; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem); padding-bottom: 0.15em; }
  .c-figures dt { color: var(--on-navy-muted); font-size: 0.9375rem; max-width: 22ch; }
  @media (min-width: 900px) {
    .c-figures__grid { grid-template-columns: repeat(4, 1fr); }
    .c-figures__grid > div { border-bottom: 0; padding: 2rem 1.5rem; border-left: 1px solid var(--rule-on-navy); }
    .c-figures__grid > div:first-child { border-left: 0; padding-left: 0; }
  }

  /* Intro */
  .c-intro { display: grid; gap: 1.5rem 5rem; }
  .c-intro h2 { margin-bottom: 1.5rem; }
  .c-intro__text { margin: 0; max-width: none; }
  @media (min-width: 960px) { .c-intro { grid-template-columns: 5fr 7fr; align-items: start; } .c-intro__text { padding-top: 2.4rem; } }
  .c-intro__hq { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--rule); font-size: 0.875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--steel); }

  /* Government */
  .c-gov { background: var(--navy); color: #fff; padding-block: var(--section-y); }
  .c-gov__top { display: grid; gap: 3rem; align-items: start; }
  .c-gov__top h2 { font-size: var(--step-5); margin-bottom: 1.25rem; }
  .c-gov__top .lead { color: var(--on-navy-muted); margin-bottom: 1.5rem; }
  @media (min-width: 1024px) { .c-gov__top { grid-template-columns: 6fr 5fr; gap: 5rem; } }
  .c-gov__steps-title { margin: 4rem 0 1.5rem; font-size: var(--step-2); }
  .c-steps { list-style: none; display: grid; border-top: 1px solid var(--rule-on-navy); border-left: 1px solid var(--rule-on-navy); }
  .c-steps li { padding: 1.5rem; border-right: 1px solid var(--rule-on-navy); border-bottom: 1px solid var(--rule-on-navy); }
  .c-steps__num { display: block; font-size: 2rem; line-height: 1; color: #fff; margin-bottom: 1rem; }
  .c-steps__num::after { content: ''; display: block; width: 2rem; height: 3px; background: var(--red); margin-top: 0.75rem; }
  .c-steps h4 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .c-steps p { margin: 0; color: var(--on-navy-muted); font-size: 1rem; }
  @media (min-width: 640px) { .c-steps { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .c-steps { grid-template-columns: repeat(4, 1fr); } }

  .c-strip { background: var(--paper); border-bottom: 1px solid var(--rule); }
  .c-strip__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 1.5rem; }
  .c-strip p { margin: 0; font-weight: 600; color: var(--navy); }

  /* Capabilities */
  .c-sub { margin-top: 1rem; }
  .c-caps { list-style: none; margin-top: 2.5rem; display: grid; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .c-caps li { padding: 1.5rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .c-caps .mono { font-size: 0.875rem; color: var(--red); }
  .c-caps h3 { margin: 0.5rem 0 0.5rem; font-size: 1.25rem; }
  .c-caps p { margin: 0; color: var(--steel); }
  @media (min-width: 640px) { .c-caps { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .c-caps { grid-template-columns: repeat(3, 1fr); } }
  .c-row { margin-top: 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; }
  .c-row p { color: var(--steel); }

  /* Experience */
  .c-exp { display: grid; }
  .c-exp__panel { background: var(--navy-deep); color: #fff; padding: var(--section-y) var(--gutter); }
  .c-exp__panel h2 { font-size: var(--step-4); max-width: 16ch; }
  .c-exp__body { padding: var(--section-y) var(--gutter); background: var(--paper); }
  .c-disclosure { margin-top: 2rem; padding: 1rem 1.25rem; background: var(--white); border-left: 3px solid var(--red); color: var(--steel); }
  .c-disclosure strong { color: var(--ink); }
  @media (min-width: 1024px) {
    .c-exp { grid-template-columns: 5fr 7fr; }
    .c-exp__panel { padding-left: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); }
    .c-exp__body { padding-right: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); padding-left: 4rem; }
  }

  /* Why */
  .c-why-title { max-width: 20ch; }
  .c-why { list-style: none; margin-top: 2.5rem; display: grid; gap: 0 3rem; }
  .c-why li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.5rem 0; border-top: 2px solid var(--navy); }
  .c-why .mono { font-size: 1.5rem; color: var(--red); line-height: 1.2; }
  .c-why h3 { font-size: var(--step-1); margin-bottom: 0.35rem; }
  .c-why p { margin: 0; }
  @media (min-width: 900px) { .c-why { grid-template-columns: 1fr 1fr; } }

  /* Coverage */
  .c-cov { background: var(--navy-deep); color: #fff; }
  .c-cov__grid { display: grid; gap: 2.5rem 4rem; }
  .c-cov h2 { margin-bottom: 1.25rem; }
  .c-cov__lists { display: grid; gap: 2rem; }
  @media (min-width: 640px) { .c-cov__lists { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .c-cov__grid { grid-template-columns: 1fr 1fr; } }
  .c-label { font-size: 0.875rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-navy-muted) !important; padding-bottom: 0.75rem; border-bottom: 2px solid var(--red); }
  .c-cov ul { list-style: none; }
  .c-cov li { padding: 0.75rem 0; border-bottom: 1px solid var(--rule-on-navy); font-weight: 600; }

  /* Commercial */
  .c-com { display: grid; gap: 2.5rem 4rem; align-items: center; }
  .c-com h2 { margin-bottom: 1.25rem; }
  .c-com__list { list-style: none; margin: 1.5rem 0 2rem; display: grid; gap: 0.5rem; }
  .c-com__list li { padding: 0.75rem 1rem; background: var(--paper); border-left: 3px solid var(--navy); font-weight: 600; color: var(--navy); }
  @media (min-width: 1024px) { .c-com { grid-template-columns: 1fr 1fr; } }

  /* Group */
  .c-group { display: grid; gap: 1.5rem 4rem; }
  @media (min-width: 960px) { .c-group { grid-template-columns: 5fr 7fr; align-items: end; } }

  /* CTA */
  .c-cta { background: var(--navy); color: #fff; border-top: 6px solid var(--red); }
  .c-cta__grid { display: grid; gap: 2rem 4rem; }
  .c-cta h2 { font-size: var(--step-5); }
  .c-cta .lead { margin-top: 1.25rem; }
  .c-cta__notice { color: var(--on-navy-muted); border-top: 1px solid var(--rule-on-navy); padding-top: 1.25rem; }
  .c-cta__notice strong { color: #fff; }
  @media (min-width: 1024px) {
    .c-cta__grid { grid-template-columns: 8fr 4fr; align-items: end; }
    .c-cta__notice { border-top: 0; border-left: 1px solid var(--rule-on-navy); padding: 0 0 0 1.5rem; }
  }
</style>
