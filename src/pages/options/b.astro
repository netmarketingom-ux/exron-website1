---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptionBar from '../../components/OptionBar.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import QuoteSheet from '../../components/QuoteSheet.astro';
import { home, site, rich } from '../../lib/content';

const { hero, strip, intro, government: gov, capabilities: caps, experience: exp, why, coverage, commercial, group, cta } = home;
const pad = (i: number) => String(i + 1).padStart(2, '0');

const index = [
  { n: '02', label: 'Who we are', href: '#b-intro' },
  { n: '03', label: 'Government support', href: '#b-gov' },
  { n: '04', label: 'What we supply', href: '#b-caps' },
  { n: '05', label: 'Experience', href: '#b-exp' },
  { n: '06', label: 'Why Exron', href: '#b-why' },
  { n: '07', label: 'Coverage', href: '#b-cov' },
  { n: '08', label: 'Commercial', href: '#b-com' },
  { n: '09', label: 'Group', href: '#b-group' },
];
---
<BaseLayout title="Homepage option B | Exron Global" description={home.seo.description} noindex>
  <OptionBar slot="top" current="B" />

  <!-- 01 Hero: white, type-led -->
  <section class="b-hero" aria-labelledby="b-hero-title">
    <div class="container b-hero__grid">
      <div class="b-hero__copy">
        <p class="b-kicker mono">{hero.eyebrow}</p>
        <h1 id="b-hero-title">{hero.title}</h1>
        <p class="b-hero__tagline">{hero.tagline}</p>
        <p class="b-hero__text">{hero.text}</p>
        <div class="b-actions">
          <a class="btn btn--primary" href="/submit-rfq/">{hero.primary_label}</a>
          <a class="btn btn--secondary" href="#b-caps">{hero.secondary_label}</a>
        </div>
      </div>
      <div class="b-hero__media">
        <PhotoSlot image={hero.image} alt={hero.image_alt} note={hero.image_note} ratio="4 / 5" priority sizes="(min-width: 1024px) 40vw, 100vw" />
      </div>
    </div>
  </section>

  <div class="b-strip on-navy">
    <div class="container b-strip__inner">
      <p set:html={rich(strip.text)} />
      <a class="btn btn--primary" href="/submit-rfq/">{strip.link_label}</a>
    </div>
  </div>

  <nav class="b-index" aria-label="On this page">
    <div class="container">
      <ol>
        {index.map((i) => <li><a href={i.href}><span class="mono">{i.n}</span>{i.label}</a></li>)}
      </ol>
    </div>
  </nav>

  <!-- 02 Intro: one large statement -->
  <section class="section" id="b-intro" aria-labelledby="b-intro-title">
    <div class="container b-intro">
      <div class="b-intro__head">
        <p class="b-num mono">02 · Who we are</p>
        <h2 id="b-intro-title" class="b-h2">{intro.title}</h2>
        <dl class="b-facts">
          {intro.facts.map((f: any) => (
            <div><dt>{f.label}</dt><dd set:html={rich(f.value)} /></div>
          ))}
        </dl>
      </div>
      <p class="b-statement" set:html={rich(intro.text)} />
    </div>
  </section>

  <!-- 03 Government: sticky heading, vertical timeline -->
  <section class="section b-gov" id="b-gov" aria-labelledby="b-gov-title">
    <div class="container b-gov__grid">
      <div class="b-gov__head">
        <p class="b-num mono">03 · {gov.eyebrow}</p>
        <h2 id="b-gov-title" class="b-h2">{gov.title}</h2>
        <p>{gov.lead}</p>
        <div class="b-gov__sheet"><QuoteSheet tone="light" /></div>
        <a class="text-link" href="/government-contracting/">{gov.link_label} <span aria-hidden="true">→</span></a>
      </div>
      <div class="b-gov__steps">
        <h3>{gov.steps_title}</h3>
        <ol class="b-timeline">
          {gov.steps.map((s: any, i: number) => (
            <li>
              <span class="b-timeline__num mono" aria-hidden="true">{pad(i)}</span>
              <h4>{s.title}</h4>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 04 Capabilities: specification table -->
  <section class="section section--paper" id="b-caps" aria-labelledby="b-caps-title">
    <div class="container">
      <p class="b-num mono">04 · Capabilities</p>
      <h2 id="b-caps-title" class="b-h2">{caps.title}</h2>
      <p class="lead">{caps.intro}</p>
      <div class="b-table-wrap">
        <table class="b-table">
          <thead><tr><th scope="col">No.</th><th scope="col">Category</th><th scope="col">Typical line items</th></tr></thead>
          <tbody>
            {caps.items.map((c: any, i: number) => (
              <tr><td class="mono">{pad(i)}</td><th scope="row">{c.name}</th><td>{c.examples}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small b-note">{caps.footnote}</p>
      <a class="text-link" href="/capabilities/">{caps.link_label} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 05 Experience -->
  <section class="section" id="b-exp" aria-labelledby="b-exp-title">
    <div class="container b-two b-exp">
      <div>
        <p class="b-num mono">05 · {exp.eyebrow}</p>
        <h2 id="b-exp-title" class="b-h2">{exp.title}</h2>
      </div>
      <div class="b-exp__body">
        <p class="b-pull" set:html={rich(exp.body[0])} />
        {exp.body.slice(1).map((p: string) => <p set:html={rich(p)} />)}
      </div>
      <p class="small b-disclosure b-exp__disclosure"><strong>Disclosure.</strong> {exp.disclosure}</p>
    </div>
  </section>

  <!-- 06 Why: bordered grid -->
  <section class="section section--paper" id="b-why" aria-labelledby="b-why-title">
    <div class="container">
      <p class="b-num mono">06 · Why Exron Global</p>
      <h2 id="b-why-title" class="b-h2">{why.title}</h2>
      <ol class="b-why">
        {why.items.map((w: any, i: number) => (
          <li>
            <span class="mono">{pad(i)}</span>
            <h3>{w.claim.replace(/\.$/, '')}</h3>
            <p set:html={rich(w.detail)} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 Coverage -->
  <section class="section" id="b-cov" aria-labelledby="b-cov-title">
    <div class="container b-two">
      <div>
        <p class="b-num mono">07 · Coverage</p>
        <h2 id="b-cov-title" class="b-h2">{coverage.title}</h2>
        <p set:html={rich(coverage.text)} />
      </div>
      <div class="b-cov">
        <div>
          <h3 class="b-label mono">{coverage.deliver_title}</h3>
          <ul>{coverage.deliver.map((c: string) => <li set:html={rich(c)} />)}</ul>
        </div>
        <div>
          <h3 class="b-label mono">{coverage.source_title}</h3>
          <ul>{coverage.source.map((c: string) => <li set:html={rich(c)} />)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 Commercial: navy band -->
  <section class="section section--navy on-navy" id="b-com" aria-labelledby="b-com-title">
    <div class="container b-com">
      <div>
        <p class="b-num b-num--light mono">08 · {commercial.eyebrow}</p>
        <h2 id="b-com-title" class="b-h2">{commercial.title}</h2>
        <p class="b-com__text">{commercial.text}</p>
        <ul class="b-com__list">{commercial.sectors.map((s: string) => <li>{s}</li>)}</ul>
        <a class="btn btn--secondary" href="/submit-rfq/?division=commercial">{commercial.button_label}</a>
      </div>
      <div class="b-com__media">
        <PhotoSlot image={commercial.image} alt={commercial.image_alt} note={commercial.image_note} ratio="4 / 3" />
      </div>
    </div>
  </section>

  <!-- 09 Group -->
  <section class="section" id="b-group" aria-labelledby="b-group-title">
    <div class="container b-two">
      <div>
        <p class="b-num mono">09 · Group affiliation</p>
        <h2 id="b-group-title" class="b-h2">{group.title}</h2>
      </div>
      <p set:html={rich(group.text)} />
    </div>
  </section>

  <!-- 10 CTA -->
  <section class="section section--paper b-cta" aria-labelledby="b-cta-title">
    <div class="container b-two b-cta__grid">
      <div>
        <p class="b-num mono">10 · Request a quotation</p>
        <h2 id="b-cta-title" class="b-h2">{cta.title}</h2>
        <p class="lead">{cta.text}</p>
        <div class="b-actions">
          <a class="btn btn--primary" href="/submit-rfq/">{cta.primary_label}</a>
          <a class="btn btn--secondary" href="/contact/">{cta.secondary_label}</a>
        </div>
      </div>
      <p class="small b-disclosure b-cta__notice"><strong>Secure transmission.</strong> {site.secure_notice}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .b-kicker { margin: 0 0 1.5rem; font-size: 0.875rem; letter-spacing: 0.2em; color: var(--red); font-weight: 500; }
  .b-num { margin: 0 0 1rem; font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--red); }
  .b-num--light { color: #fff; }
  .b-h2 { max-width: 22ch; margin-bottom: 1.5rem; }
  .b-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .b-two { display: grid; gap: 1.5rem 4rem; }
  @media (min-width: 960px) { .b-two { grid-template-columns: 5fr 7fr; } }

  /* Hero */
  .b-hero { padding-block: clamp(2.5rem, 2rem + 4vw, 5.5rem); border-bottom: 1px solid var(--rule); }
  .b-hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  .b-hero h1 {
    font-size: clamp(2.125rem, 1.4rem + 2.4vw, 3.375rem); line-height: 1.06; max-width: 22ch;
    padding-left: 1.25rem; border-left: 6px solid var(--red);
  }
  .b-hero__tagline { margin: 1.5rem 0 0; font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 650; font-size: var(--step-1); color: var(--navy-deep); }
  .b-hero__text { margin-top: 1rem; color: var(--steel); max-width: 58ch; }
  @media (min-width: 1024px) { .b-hero__grid { grid-template-columns: 7fr 5fr; gap: 4rem; } }

  .b-strip { background: var(--navy-deep); color: #fff; }
  .b-strip__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 1.25rem; }
  .b-strip p { margin: 0; color: var(--on-navy-muted); max-width: 70ch; }

  /* Section index */
  .b-index { border-bottom: 1px solid var(--rule); background: var(--white); }
  .b-index ol { list-style: none; display: flex; gap: 0 2rem; overflow-x: auto; padding-block: 0.25rem; scrollbar-width: thin; }
  .b-index a { display: inline-flex; gap: 0.5rem; align-items: baseline; padding: 0.9rem 0; white-space: nowrap; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1rem; }
  .b-index a:hover { color: var(--red); }
  .b-index .mono { font-size: 0.8125rem; color: var(--red); font-weight: 400; }

  /* Intro */
  .b-intro { display: grid; gap: 2rem 5rem; }
  .b-statement { margin: 0; font-size: clamp(1.375rem, 1.1rem + 1.1vw, 1.875rem); line-height: 1.5; max-width: none; color: var(--navy-deep); }
  .b-facts { margin: 2.5rem 0 0; border-top: 2px solid var(--navy); }
  .b-facts > div { padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .b-facts dt { font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .b-facts dd { margin: 0.35rem 0 0; font-weight: 600; color: var(--navy); }
  @media (min-width: 960px) {
    .b-intro { grid-template-columns: 5fr 7fr; align-items: start; }
    .b-statement { padding-top: 2.4rem; padding-left: 2.5rem; border-left: 3px solid var(--red); }
  }

  /* Government */
  .b-gov { border-top: 6px solid var(--navy); }
  .b-gov__grid { display: grid; gap: 3rem 5rem; }
  .b-gov__head .b-h2 { font-size: var(--step-5); }
  .b-gov__sheet { margin: 2rem 0; }
  .b-gov__steps h3 { font-size: var(--step-2); margin-bottom: 1.5rem; }
  .b-timeline { list-style: none; position: relative; }
  .b-timeline::before { content: ''; position: absolute; left: 1.35rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--rule); }
  .b-timeline li { position: relative; padding: 0 0 1.75rem 4rem; }
  .b-timeline__num {
    position: absolute; left: 0; top: 0; width: 2.75rem; height: 2.75rem; display: grid; place-items: center;
    background: var(--navy); color: #fff; font-size: 0.875rem;
  }
  .b-timeline h4 { font-size: var(--step-1); padding-top: 0.45rem; margin-bottom: 0.35rem; }
  .b-timeline p { margin: 0; }
  @media (min-width: 1024px) {
    .b-gov__grid { grid-template-columns: 5fr 6fr; }
    .b-gov__head { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  }

  /* Capabilities table */
  .b-table-wrap { margin-top: 2.5rem; overflow-x: auto; }
  .b-table { width: 100%; border-collapse: collapse; background: var(--white); }
  .b-table thead th {
    text-align: left; padding: 0.85rem 1rem; background: var(--navy); color: #fff;
    font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .b-table td, .b-table tbody th { padding: 1rem; border-bottom: 1px solid var(--rule); vertical-align: top; text-align: left; }
  .b-table tbody th { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 650; color: var(--navy); font-size: 1.125rem; }
  .b-table td:first-child { color: var(--red); width: 4rem; }
  .b-table td:last-child { color: var(--steel); }
  @media (max-width: 639px) {
    .b-table thead { display: none; }
    .b-table tr { display: grid; grid-template-columns: 2.5rem 1fr; padding: 0.9rem 0.75rem; border-bottom: 1px solid var(--rule); }
    .b-table td, .b-table tbody th { padding: 0; border: 0; }
    .b-table td:last-child { grid-column: 2; margin-top: 0.25rem; }
  }
  .b-note { margin: 1.5rem 0 1rem; color: var(--steel); }

  /* Experience */
  .b-pull { font-size: var(--step-2); line-height: 1.4; color: var(--navy-deep); padding-left: 1.25rem; border-left: 3px solid var(--red); }
  .b-disclosure { margin-top: 2rem; padding: 1rem 1.25rem; background: var(--paper); border-left: 3px solid var(--navy); color: var(--steel); }
  .section--paper .b-disclosure { background: var(--white); }
  .b-disclosure strong { color: var(--ink); }

  @media (min-width: 960px) {
    .b-exp__body { grid-column: 2; grid-row: 1 / span 2; }
    .b-exp__disclosure { grid-column: 1; grid-row: 2; align-self: start; margin-top: 0; }
  }

  /* Why grid */
  .b-why { list-style: none; display: grid; margin-top: 2.5rem; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .b-why li { padding: 1.5rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: var(--white); }
  .b-why .mono { font-size: 0.875rem; color: var(--red); }
  .b-why h3 { margin: 0.5rem 0 0.4rem; font-size: 1.25rem; }
  .b-why p { margin: 0; color: var(--ink); }
  @media (min-width: 640px) { .b-why { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .b-why { grid-template-columns: repeat(5, 1fr); } }

  /* Coverage */
  .b-cov { display: grid; gap: 2rem; }
  @media (min-width: 640px) { .b-cov { grid-template-columns: 1fr 1fr; } }
  .b-label { font-size: 0.875rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); padding-bottom: 0.75rem; border-bottom: 2px solid var(--navy); }
  .b-cov ul { list-style: none; }
  .b-cov li { padding: 0.75rem 0; border-bottom: 1px solid var(--rule); font-weight: 600; }

  /* Commercial */
  .b-com { display: grid; gap: 2.5rem 4rem; align-items: center; }
  .b-com__text { color: var(--on-navy-muted); }
  .b-com__list { list-style: none; margin: 1.5rem 0 2rem; border-top: 1px solid var(--rule-on-navy); }
  .b-com__list li { padding: 0.7rem 0; border-bottom: 1px solid var(--rule-on-navy); font-weight: 600; }
  .b-com__media :global(.photo-slot) { background: rgba(255, 255, 255, 0.06); border-color: var(--rule-on-navy); }
  .b-com__media :global(.photo-slot figcaption) { color: var(--on-navy-muted); }
  @media (min-width: 1024px) { .b-com { grid-template-columns: 6fr 5fr; } }

  .b-cta { border-top: 4px solid var(--red); }
  @media (min-width: 960px) {
    .b-cta__grid { grid-template-columns: 7fr 5fr; align-items: end; }
    .b-cta__notice { margin: 0; }
  }
</style>
