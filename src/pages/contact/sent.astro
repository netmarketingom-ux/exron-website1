---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
---
<BaseLayout title="Message sent | Exron Global" description="Confirmation that your message has been sent to Exron Global." noindex>
  <PageHead eyebrow="Contact" title="Message sent" summary="Thank you. Your message has reached our team and we will reply by email." />
  <section class="section">
    <div class="container">
      <p>If your message is about a quotation, sending the RFQ through the form lets us log it and reply faster.</p>
      <p><a class="text-link" href="/submit-rfq/">Submit an RFQ</a></p>
    </div>
  </section>
</BaseLayout>
