---
import BaseLayout from '../../legacy/layouts/BaseLayout.astro';
import PageHero from '../../legacy/components/PageHero.astro';
import Icon from '../../legacy/components/Icon.astro';
---
<BaseLayout title="Message sent | Exron Global" description="Confirmation that your message has been sent to Exron Global." noindex>
  <PageHero eyebrow="Contact" title="Message sent" lead="Thank you. Your message has reached our team and we will reply by email." crumb="Message sent" />
  <section class="section">
    <div class="container">
      <p class="lead">If your message is about a quotation, sending the RFQ through the form lets us log it with a reference number and reply faster.</p>
      <div class="btn-row">
        <a class="btn btn--quote" href="/submit-rfq/">Submit an RFQ</a>
        <a class="link-arrow" href="/">Return to the homepage<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>
