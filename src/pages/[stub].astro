---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import StubNotice from '../components/StubNotice.astro';
import VendorList from '../components/VendorList.astro';
import { visibleVendorFields } from '../lib/content';

export function getStaticPaths() {
  return ['about', 'capabilities', 'industries', 'government-contracting'].map((stub) => ({ params: { stub } }));
}

const { stub } = Astro.params;
const page = (await getEntry('pages', stub))!;
const showVendor = stub === 'government-contracting' && visibleVendorFields.length > 0;
---
<BaseLayout title={page.data.seo_title} description={page.data.description} noindex={page.data.noindex}>
  <PageHead eyebrow="Exron Global" title={page.data.title} />
  <StubNotice summary={page.data.summary}>
    {showVendor && (
      <div class="vendor-block" id="vendor-information">
        <h2>Vendor information</h2>
        <VendorList fields={visibleVendorFields} />
      </div>
    )}
  </StubNotice>
</BaseLayout>

<style>
  .vendor-block { margin-top: 3rem; }
  .vendor-block h2 { font-size: var(--step-3); margin-bottom: 1.25rem; }
</style>
