---
import BaseLayout from '../legacy/layouts/BaseLayout.astro';
import PageHero from '../legacy/components/PageHero.astro';
import Icon from '../legacy/components/Icon.astro';

const links = [
  { label: 'Homepage', href: '/' },
  { label: 'Capabilities', href: '/capabilities/' },
  { label: 'Government Contracting', href: '/government-contracting/' },
  { label: 'Contact', href: '/contact/' },
];
---
<BaseLayout title="Page not found | Exron Global" description="The page you requested does not exist." noindex>
  <PageHero eyebrow="Error 404" title="Page not found" lead="The address may be mistyped, or the page may have moved." crumb="Page not found" buttons={[{ label: 'Submit an RFQ', href: '/submit-rfq/' }]} />
  <section class="section">
    <div class="container">
      <ul class="nf-links">
        {links.map((l) => <li><a class="link-arrow" href={l.href}>{l.label}<Icon name="arrow-right" /></a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-links { list-style: none; display: grid; gap: 1rem; }
</style>
