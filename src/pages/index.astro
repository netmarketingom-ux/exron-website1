---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import QuoteSheet from '../components/QuoteSheet.astro';
import { home, site, rich, resolveImage } from '../lib/content';

const { hero, strip, intro, government: gov, capabilities: caps, experience: exp, why, coverage, commercial, group, cta } = home;
const pad = (i: number) => String(i + 1).padStart(2, '0');

const heroImage = resolveImage(hero.image);
const heroBg = heroImage ? await getImage({ src: heroImage, width: 1920, format: 'webp' }) : undefined;
---
<BaseLayout title={home.seo.title} description={home.seo.description}>
  {heroBg && <link slot="head" rel="preload" as="image" href={heroBg.src} fetchpriority="high" />}

  <!-- 01 Opening banner -->
  <section class="hero on-navy" aria-labelledby="hero-title" style={heroBg ? `--hero-img:url(${heroBg.src})` : undefined}>
    {heroBg && <div class="hero__img" role="img" aria-label={hero.image_alt}></div>}
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow mono">{hero.eyebrow}</p>
        <h1 id="hero-title">{hero.title}</h1>
        <p class="hero__tagline">{hero.tagline}</p>
        <p class="hero__text">{hero.text}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/submit-rfq/">{hero.primary_label}</a>
          <a class="btn btn--secondary" href="#capabilities">{hero.secondary_label}</a>
        </div>
      </div>
      <aside class="hero__panel" aria-label={hero.panel_title}>
        <p class="hero__panel-title mono">{hero.panel_title}</p>
        <dl>
          {hero.panel.map((row: any) => (
            <div>
              <dt>{row.label}</dt>
              <dd set:html={rich(row.value)} />
            </div>
          ))}
        </dl>
      </aside>
    </div>
    {!heroBg && <p class="hero__photo-note container mono">{hero.image_note}</p>}
  </section>

  <div class="strip on-navy">
    <div class="container strip__inner">
      <p set:html={rich(strip.text)} />
      <a class="strip__link" href="/submit-rfq/">{strip.link_label} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>

  <!-- 02 Introduction -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container grid">
      <div class="intro__head">
        <Eyebrow num="02" text="Who we are" />
        <h2 id="intro-title">{intro.title}</h2>
      </div>
      <div class="intro__body">
        <p class="lead" set:html={rich(intro.text)} />
      </div>
      <dl class="facts">
        {intro.facts.map((f: any) => (
          <div class="facts__item">
            <dt>{f.label}</dt>
            <dd set:html={rich(f.value)} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 03 Government & military installation support -->
  <section class="gov" id="government" aria-labelledby="gov-title">
    <div class="gov__band on-navy">
      <div class="container grid">
        <div class="gov__head">
          <Eyebrow num="03" text={gov.eyebrow} />
          <h2 id="gov-title">{gov.title}</h2>
          <p class="lead">{gov.lead}</p>
        </div>
        <div class="gov__photo">
          {gov.image
            ? <PhotoSlot image={gov.image} alt={gov.image_alt} note={gov.image_note} ratio="4 / 3" />
            : <QuoteSheet />}
        </div>
      </div>
    </div>
    <div class="container">
      <div class="gov__sheet">
        <div class="gov__sheet-head">
          <h3>{gov.steps_title}</h3>
          <p class="mono small">08 steps · from solicitation to receiving</p>
        </div>
        <ol class="steps">
          {gov.steps.map((s: any, i: number) => (
            <li class="steps__item">
              <span class="steps__num mono" aria-hidden="true">{pad(i)}</span>
              <div>
                <h4>{s.title}.</h4>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="gov__sheet-foot">
          <a class="text-link" href="/government-contracting/">{gov.link_label} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Core procurement capabilities -->
  <section class="section" id="capabilities" aria-labelledby="caps-title">
    <div class="container grid">
      <div class="caps__head">
        <Eyebrow num="04" text="Capabilities" />
        <h2 id="caps-title">{caps.title}</h2>
        <p class="lead">{caps.intro}</p>
      </div>
      <ul class="caps">
        {caps.items.map((c: any, i: number) => (
          <li class="caps__row">
            <span class="caps__num mono" aria-hidden="true">{pad(i)}</span>
            <div>
              <h3>{c.name}</h3>
              <p>{c.examples}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="caps__foot">
        <p class="small">{caps.footnote}</p>
        <a class="text-link" href="/capabilities/">{caps.link_label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 05 Management experience -->
  <section class="section section--paper" id="experience" aria-labelledby="exp-title">
    <div class="container grid">
      <div class="exp__head">
        <Eyebrow num="05" text={exp.eyebrow} />
        <h2 id="exp-title">{exp.title}</h2>
      </div>
      <div class="exp__body">
        {exp.body.map((p: string, i: number) => <p class:list={[i === 0 && 'lead']} set:html={rich(p)} />)}
      </div>
      <p class="exp__disclosure small"><strong>Disclosure.</strong> {exp.disclosure}</p>
      {exp.show_leadership && (
        <ul class="leaders">
          {exp.leadership.map((l: any) => (
            <li>
              <p class="leaders__name" set:html={rich(l.name)} />
              <p class="leaders__title mono small" set:html={rich(l.title)} />
              <p class="small" set:html={rich(l.background)} />
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- 06 Why choose Exron Global -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <Eyebrow num="06" text="Why Exron Global" />
      <h2 id="why-title" class="why__title">{why.title}</h2>
      <ol class="why">
        {why.items.map((w: any, i: number) => (
          <li class="why__item">
            <span class="why__num mono" aria-hidden="true">{pad(i)}</span>
            <p><strong>{w.claim}</strong> <span set:html={rich(w.detail)} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 07 International sourcing and coverage -->
  <section class="section section--navy on-navy" aria-labelledby="cov-title">
    <div class="container grid">
      <div class="cov__head">
        <Eyebrow num="07" text="Coverage" />
        <h2 id="cov-title">{coverage.title}</h2>
        <p class="lead" set:html={rich(coverage.text)} />
      </div>
      <div class="cov__lists">
        <div>
          <h3 class="cov__label mono">{coverage.deliver_title}</h3>
          <ul>{coverage.deliver.map((c: string) => <li set:html={rich(c)} />)}</ul>
        </div>
        <div>
          <h3 class="cov__label mono">{coverage.source_title}</h3>
          <ul>{coverage.source.map((c: string) => <li set:html={rich(c)} />)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 Commercial and industrial division -->
  <section class="section" aria-labelledby="com-title">
    <div class="container grid">
      <div class="com__photo">
        <PhotoSlot image={commercial.image} alt={commercial.image_alt} note={commercial.image_note} ratio="4 / 3" />
      </div>
      <div class="com__body">
        <Eyebrow num="08" text={commercial.eyebrow} />
        <h2 id="com-title">{commercial.title}</h2>
        <p>{commercial.text}</p>
        <ul class="com__list">
          {commercial.sectors.map((s: string) => <li>{s}</li>)}
        </ul>
        <a class="btn btn--secondary" href="/submit-rfq/?division=commercial">{commercial.button_label}</a>
      </div>
    </div>
  </section>

  <!-- 09 Group affiliation -->
  <section class="section section--paper" aria-labelledby="group-title">
    <div class="container grid">
      <div class="group__head">
        <Eyebrow num="09" text="Group affiliation" />
        <h2 id="group-title">{group.title}</h2>
      </div>
      <div class="group__body">
        <p set:html={rich(group.text)} />
      </div>
      {group.show_logos && (
        <ul class="group__logos">
          {group.logos.map((l: any) => {
            const img = resolveImage(l.image);
            return <li>{img ? <img src={img.src} width={img.width} height={img.height} alt={l.name} loading="lazy" /> : <span set:html={rich(l.name)} />}</li>;
          })}
        </ul>
      )}
    </div>
  </section>

  <!-- 10 Closing call to action -->
  <section class="section cta on-navy" aria-labelledby="cta-title">
    <div class="container grid">
      <div class="cta__body">
        <Eyebrow num="10" text="Request a quotation" />
        <h2 id="cta-title">{cta.title}</h2>
        <p class="lead">{cta.text}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/submit-rfq/">{cta.primary_label}</a>
          <a class="btn btn--secondary" href="/contact/">{cta.secondary_label}</a>
        </div>
      </div>
      <p class="cta__notice small"><strong>Secure transmission.</strong> {site.secure_notice}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Netlify Identity invitation and recovery links land on the homepage; hand them to the CMS.
  if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
    location.replace('/admin/' + location.hash);
  }
</script>

<style>
  /* 01 Hero */
  .hero { position: relative; background: var(--navy); color: #fff; overflow: hidden; }
  .hero__img {
    position: absolute; inset: 0; background: var(--hero-img) center / cover no-repeat;
  }
  .hero__img::after { content: ''; position: absolute; inset: 0; background: rgba(42, 41, 80, 0.62); }
  .hero__inner {
    position: relative; display: grid; gap: 2.5rem;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .hero__eyebrow {
    display: inline-flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;
    font-size: 0.875rem; font-weight: 500; letter-spacing: 0.2em; color: var(--on-navy-muted);
  }
  .hero__eyebrow::before { content: ''; width: 2.5rem; height: 3px; background: var(--red); }
  .hero h1 { color: #fff; max-width: 22ch; font-size: clamp(2.125rem, 1.4rem + 2.5vw, 3.5rem); line-height: 1.06; }
  .hero__tagline {
    margin: 1.25rem 0 0; font-family: var(--font-display); font-stretch: var(--display-stretch);
    font-weight: 600; font-size: var(--step-1); color: #fff;
  }
  .hero__text { margin-top: 1rem; color: var(--on-navy-muted); max-width: 60ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__panel {
    align-self: end; border: 1px solid var(--rule-on-navy); background: rgba(42, 41, 80, 0.55);
    padding: 1.5rem;
  }
  .hero__panel-title {
    margin: 0 0 0.5rem; font-size: 0.875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-navy-muted);
  }
  .hero__panel dl { margin: 0; }
  .hero__panel dl > div { padding: 0.85rem 0; border-top: 1px solid var(--rule-on-navy); }
  .hero__panel dt {
    font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-navy-muted);
  }
  .hero__panel dd { margin: 0.2rem 0 0; color: #fff; font-size: 1.0625rem; line-height: 1.45; }
  .hero__photo-note {
    position: relative; margin: 0 auto; padding-bottom: 1rem; font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--on-navy-muted);
  }
  @media (min-width: 1024px) {
    .hero__inner { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 4rem; }
  }

  .strip { background: var(--navy-deep); color: #fff; }
  .strip__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 2rem; padding-block: 1.1rem; }
  .strip p { margin: 0; max-width: none; color: var(--on-navy-muted); }
  .strip__link { color: #fff; font-weight: 650; white-space: nowrap; text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .strip__link:hover { color: #fff; }

  /* 02 Intro */
  .intro__body { margin-top: 1.5rem; }
  .facts { margin: 3rem 0 0; display: grid; border-top: 1px solid var(--rule); }
  .facts__item { padding: 1.1rem 0; border-bottom: 1px solid var(--rule); }
  .facts dt { font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .facts dd { margin: 0.3rem 0 0; font-weight: 600; color: var(--navy); }
  @media (min-width: 900px) {
    .intro__head { grid-column: 1 / span 5; }
    .intro__body { grid-column: 7 / span 6; margin-top: 2.6rem; }
    .facts { grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--rule); }
    .facts__item { padding: 1.25rem 1.5rem 1.25rem 0; border-bottom: 0; }
    .facts__item + .facts__item { padding-left: 1.5rem; border-left: 1px solid var(--rule); }
  }

  /* 03 Government (largest section) */
  .gov__band { background: var(--navy); color: #fff; padding-block: var(--section-y) calc(var(--section-y) + 4rem); }
  .gov__band h2 { color: #fff; font-size: var(--step-5); }
  .gov__band .lead { margin-top: 1.5rem; color: var(--on-navy-muted); }
  .gov__photo { margin-top: 2.5rem; }
  .gov__photo :global(.photo-slot) { background: rgba(255, 255, 255, 0.06); border-color: var(--rule-on-navy); }
  .gov__photo :global(.photo-slot figcaption) { color: var(--on-navy-muted); }
  @media (min-width: 1024px) {
    .gov__head { grid-column: 1 / span 6; }
    .gov__photo { grid-column: 8 / span 5; margin-top: 0; align-self: center; }
  }
  .gov__sheet {
    position: relative; margin-top: -4rem; margin-bottom: var(--section-y);
    background: var(--white); border: 1px solid var(--rule); border-top: 4px solid var(--red);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }
  .gov__sheet-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--rule); }
  .gov__sheet-head h3 { font-size: var(--step-2); }
  .gov__sheet-head p { margin: 0; color: var(--steel); letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.875rem; }
  .steps { list-style: none; display: grid; }
  .steps__item { display: grid; grid-template-columns: 2.25rem 1fr; gap: 1rem; padding: 1.4rem 0; border-bottom: 1px solid var(--rule); }
  .steps__num { font-size: 1.125rem; font-weight: 500; color: var(--red); line-height: 1.4; }
  .steps h4 { font-size: var(--step-1); margin-bottom: 0.35rem; }
  .steps p { margin: 0; color: var(--ink); }
  .gov__sheet-foot { padding-top: 1.5rem; }
  @media (min-width: 900px) {
    .steps__item { grid-template-columns: 3rem 1fr; }
    .steps { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(4, auto); grid-auto-flow: column; column-gap: 3rem; }
  }

  /* 04 Capabilities */
  .caps { list-style: none; margin-top: 3rem; display: grid; border-top: 2px solid var(--navy); }
  .caps__row { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule); }
  .caps__num { font-size: 0.875rem; color: var(--steel); padding-top: 0.2rem; }
  .caps h3 { font-size: 1.1875rem; color: var(--navy); }
  .caps p { margin: 0.25rem 0 0; color: var(--steel); }
  .caps__head .lead { margin-top: 1rem; }
  .caps__foot { margin-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; }
  .caps__foot p { color: var(--steel); }
  @media (min-width: 900px) {
    .caps__head { grid-column: 1 / span 7; }
    .caps { grid-template-columns: 1fr 1fr; column-gap: 3rem; }
  }

  /* 05 Experience */
  .exp__body { margin-top: 1.5rem; }
  .exp__disclosure {
    margin-top: 2rem; padding: 1rem 1.25rem; background: var(--white); border-left: 3px solid var(--navy); color: var(--steel);
  }
  .exp__disclosure strong { color: var(--ink); }
  .leaders { list-style: none; margin-top: 3rem; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .leaders li { border-top: 2px solid var(--navy); padding-top: 1rem; }
  .leaders__name { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 700; font-size: var(--step-1); color: var(--navy); margin: 0; }
  .leaders__title { color: var(--steel); text-transform: uppercase; letter-spacing: 0.08em; margin: 0.25rem 0 0.5rem; }
  @media (min-width: 900px) {
    .exp__head { grid-column: 1 / span 5; }
    .exp__body { grid-column: 7 / span 6; grid-row: 1 / span 2; margin-top: 2.6rem; }
    .exp__disclosure { grid-column: 1 / span 5; grid-row: 2; align-self: start; margin-top: 1rem; }
  }

  /* 06 Why */
  .why__title { max-width: 22ch; }
  .why { list-style: none; margin-top: 3rem; display: grid; border-top: 1px solid var(--rule); }
  .why__item { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule); }
  .why__num { font-size: 0.875rem; color: var(--red); padding-top: 0.25rem; }
  .why p { margin: 0; }
  .why strong { color: var(--navy); font-weight: 700; }
  @media (min-width: 900px) {
    .why { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(5, auto); grid-auto-flow: column; column-gap: 3rem; }
  }

  /* 07 Coverage */
  .cov__head .lead { margin-top: 1.5rem; color: var(--on-navy-muted); }
  .cov__lists { margin-top: 2.5rem; display: grid; gap: 2rem; }
  .cov__label { font-size: 0.875rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-navy-muted) !important; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule-on-navy); }
  .cov__lists ul { list-style: none; }
  .cov__lists li { padding: 0.75rem 0; border-bottom: 1px solid var(--rule-on-navy); font-weight: 600; }
  @media (min-width: 640px) { .cov__lists { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) {
    .cov__head { grid-column: 1 / span 6; }
    .cov__lists { grid-column: 8 / span 5; margin-top: 2.6rem; }
  }

  /* 08 Commercial */
  .com__body { margin-top: 2rem; }
  .com__body p { margin-top: 1.25rem; }
  .com__list { list-style: none; margin: 1.5rem 0 2rem; border-top: 1px solid var(--rule); }
  .com__list li { padding: 0.7rem 0 0.7rem 1.25rem; border-bottom: 1px solid var(--rule); position: relative; font-weight: 600; color: var(--navy); }
  .com__list li::before { content: ''; position: absolute; left: 0; top: 1.3em; width: 0.5rem; height: 2px; background: var(--red); }
  @media (min-width: 1024px) {
    .com__photo { grid-column: 1 / span 5; align-self: start; }
    .com__body { grid-column: 7 / span 6; margin-top: 0; }
  }

  /* 09 Group */
  .group__body { margin-top: 1.5rem; }
  .group__logos { list-style: none; margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 2rem 3rem; align-items: center; }
  .group__logos img { max-height: 56px; width: auto; }
  @media (min-width: 900px) {
    .group__head { grid-column: 1 / span 5; }
    .group__body { grid-column: 7 / span 6; margin-top: 2.6rem; }
  }

  /* 10 CTA */
  .cta { background: var(--navy); color: #fff; border-top: 4px solid var(--red); }
  .cta h2 { color: #fff; }
  .cta .lead { margin-top: 1.25rem; color: var(--on-navy-muted); }
  .cta__notice { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--rule-on-navy); color: var(--on-navy-muted); }
  .cta__notice strong { color: #fff; }
  @media (min-width: 1024px) {
    .cta__body { grid-column: 1 / span 8; }
    .cta__notice { grid-column: 9 / span 4; align-self: end; margin-top: 0; padding: 0 0 0 1.5rem; border-top: 0; border-left: 1px solid var(--rule-on-navy); }
  }
</style>
