---
import { getEntry } from 'astro:content';
import BaseLayout from '../../legacy/layouts/BaseLayout.astro';
import PageHero from '../../legacy/components/PageHero.astro';
import Icon from '../../legacy/components/Icon.astro';
import RfqForm from '../../components/RfqForm.astro';
import { rich, site, isSet } from '../../legacy/lib/site';
import { loadPage } from '../../legacy/lib/page';
import capsRaw from '../../legacy/content/pages/capabilities.md?raw';

const page = (await getEntry('pages', 'submit-rfq'))!;
const next = loadPage(capsRaw).sourcing.steps.slice(0, 4);
const secure = 'Do not send classified information, Controlled Unclassified Information (CUI) or export-controlled technical data through this website. If your requirement involves such information, contact us first to agree an appropriate secure method of transmission.';
---
<BaseLayout title={page.data.seo_title} description={page.data.description} noindex={page.data.noindex}>
  <PageHero eyebrow="RFQ Desk" title={page.data.title} lead={page.data.summary} crumb="Submit an RFQ" />

  <section class="section rfq-page">
    <div class="container rfq-page__grid">
      <div class="form-scope">
        <RfqForm />
      </div>

      <aside class="rfq-page__aside" aria-label="About this form">
        <div class="data-card">
          <p class="data-card__title">What happens next</p>
          <ol class="rfq-next">
            {next.map((s: any, i: number) => (
              <li>
                <span class="rfq-next__num">{String(i + 1).padStart(2, '0')}</span>
                <div><strong>{s.title}.</strong> {s.text}</div>
              </li>
            ))}
          </ol>
          <p class="data-card__note">You receive an acknowledgment email with your reference number <span set:html={rich('{rfqAcknowledgment}')} />.</p>
        </div>

        <p class="notice notice--warn"><Icon name="shield" /><span><strong>Controlled information.</strong> {secure}</span></p>

        <div class="data-card">
          <p class="data-card__title">Prefer email?</p>
          <p class="rfq-page__email">
            Send the solicitation and attachments to
            {isSet(site.procurementEmail)
              ? <a href={`mailto:${site.procurementEmail}`}>{site.procurementEmail}</a>
              : <span set:html={rich(site.procurementEmail)} />}.
            Put the RFQ number in the subject line.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .rfq-page__grid { display: grid; gap: 3rem; align-items: start; }
  .rfq-page__grid > * { min-width: 0; }
  @media (min-width: 1024px) { .rfq-page__grid { grid-template-columns: 1.6fr 0.9fr; gap: 3.5rem; } }
  .rfq-page__aside { display: grid; gap: 1.5rem; }
  .rfq-next { list-style: none; display: grid; gap: 1rem; padding: 1.25rem 1.5rem; font-size: 0.9375rem; line-height: 1.5; }
  .rfq-next li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.5rem; }
  .rfq-next__num { font-family: var(--font-mono); color: var(--red-600); font-size: 0.875rem; padding-top: 0.1rem; }
  .rfq-next strong { color: var(--ink-900); }
  .rfq-page__email { margin: 0; padding: 1.25rem 1.5rem; font-size: 0.9375rem; }
</style>
