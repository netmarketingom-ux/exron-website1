---
import BaseLayout from '../../legacy/layouts/BaseLayout.astro';
import PageHero from '../../legacy/components/PageHero.astro';
import { rich, site, isSet } from '../../legacy/lib/site';
import { loadPage } from '../../legacy/lib/page';
import capsRaw from '../../legacy/content/pages/capabilities.md?raw';

const steps = loadPage(capsRaw).sourcing.steps.slice(1, 4);
const procurementEmail = isSet(site.procurementEmail) ? site.procurementEmail : '';
---
<BaseLayout
  title="RFQ received | Exron Global"
  description="Confirmation that your RFQ has been submitted to Exron Global procurement."
  noindex
>
  <PageHero eyebrow="RFQ received" title="Your RFQ has been submitted" crumb="RFQ received">
    <div class="ref" data-ref-box hidden slot="aside">
      <p class="ref__label mono">Your reference</p>
      <p class="ref__value mono" data-ref></p>
    </div>
  </PageHero>

  <section class="section">
    <div class="container received">
      <p class="lead">
        We have your request. An acknowledgment email with the reference number and a summary of what you sent goes to the address you entered.
        Our procurement team will contact you <span set:html={rich('{rfqAcknowledgment}')} /> to confirm the response deadline and any points we need to clarify.
      </p>
      <h2>What happens next</h2>
      <ol class="received__steps">
        {steps.map((s: any, i: number) => (
          <li><span class="mono">{String(i + 2).padStart(2, '0')}</span><div><strong>{s.title}.</strong> {s.text}</div></li>
        ))}
      </ol>
      <p>
        Quote the reference in any follow-up. If the acknowledgment has not arrived, check your spam folder or write to
        {procurementEmail ? <a href={`mailto:${procurementEmail}`}>{procurementEmail}</a> : <span set:html={rich(site.procurementEmail)} />}.
      </p>
      <p><a class="link-arrow" href="/">Return to the homepage <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { REFERENCE_RE } from '../../lib/rfq/rules';
  let ref = new URLSearchParams(location.search).get('ref') ?? '';
  if (!REFERENCE_RE.test(ref)) {
    try { ref = sessionStorage.getItem('exron-rfq-ref') ?? ''; } catch { ref = ''; }
  }
  if (REFERENCE_RE.test(ref)) {
    document.querySelector('[data-ref]')!.textContent = ref;
    document.querySelector<HTMLElement>('[data-ref-box]')!.hidden = false;
  }
</script>

<style>
  .ref { background: #fff; border-top: 4px solid var(--red-600); padding: 1.5rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .ref__label { margin: 0; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy-700); }
  .ref__value { margin: 0.5rem 0 0; font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem); font-weight: 500; color: var(--ink-900); letter-spacing: 0.04em; }
  .received { max-width: 52rem; }
  .received h2 { margin: 2.5rem 0 1rem; }
  .received__steps { list-style: none; display: grid; margin-bottom: 2rem; border-top: 1px solid var(--line); }
  .received__steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .received__steps .mono { color: var(--red-600); }
  .received__steps strong { color: var(--ink-900); }
</style>
