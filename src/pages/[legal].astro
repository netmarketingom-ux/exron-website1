---
import { getEntry } from 'astro:content';
import BaseLayout from '../legacy/layouts/BaseLayout.astro';
import PageHero from '../legacy/components/PageHero.astro';
import { PLACEHOLDER_RE } from '../legacy/lib/site';

export function getStaticPaths() {
  return ['privacy', 'terms'].map((legal) => ({ params: { legal } }));
}

const page = (await getEntry('pages', Astro.params.legal))!;
const mark = (html: string) => html.replace(PLACEHOLDER_RE, (m) => `<mark class="ph">${m}</mark>`);
const html = mark(page.rendered?.html ?? '');
---
<BaseLayout title={page.data.seo_title} description={page.data.description} noindex={page.data.noindex}>
  <PageHero eyebrow="Legal" title={page.data.title} lead={page.data.summary} crumb={page.data.title} />
  <section class="section">
    <div class="container">
      <div class="prose" set:html={html} />
    </div>
  </section>
</BaseLayout>
