---
/**
 * Sales CTA bands from the approved copy.
 *  variant="closing"  → navy end-of-page block (heading, text, up to 2 buttons)
 *  variant="banner"   → mid-page strip ("One supplier. Every requirement.")
 *  variant="secondary"→ light "Prefer to talk first?" strip
 */
import Button from './Button.astro';
import { rich } from '../lib/site';
import Rich from './Rich.astro';

interface Btn { label: string; href: string; }
interface Props {
  variant?: 'closing' | 'banner' | 'secondary';
  heading: string;
  text?: string;
  buttons?: Btn[];
}
const { variant = 'closing', heading, text, buttons = [] } = Astro.props;

const style = (b: Btn, i: number) => {
  if (b.href === 'whatsapp') return { variant: 'whatsapp' as const, icon: 'whatsapp' };
  if (i === 0 && variant !== 'secondary') return { variant: 'quote' as const, icon: undefined };
  return { variant: variant === 'secondary' ? 'secondary' as const : 'ghost' as const, icon: undefined };
};
---
<section class:list={['cta', `cta--${variant}`]}>
  <div class="container cta__inner">
    <div class="cta__text">
      <h2><Rich text={heading} /></h2>
      {text && <p set:html={rich(text)} />}
    </div>
    {buttons.length > 0 && (
      <div class="btn-row btn-row--stack cta__actions">
        {buttons.map((b, i) => {
          const s = style(b, i);
          return <Button href={b.href} variant={s.variant} icon={s.icon} size="lg">{b.label}</Button>;
        })}
      </div>
    )}
  </div>
</section>

<style>
  .cta__inner { display: grid; gap: 1.75rem; align-items: center; }
  .cta h2 { margin-bottom: 0.75rem; }
  .cta p { margin: 0; max-width: 60ch; }
  @media (min-width: 900px) { .cta__inner { grid-template-columns: 1fr auto; gap: 3rem; } }

  .cta--closing {
    position: relative; overflow: hidden; padding-block: var(--section-y);
    background: radial-gradient(1200px 400px at 85% -10%, rgba(47, 116, 200, 0.35), transparent 60%), var(--navy-900);
    color: #c8d3e2;
  }
  .cta--closing h2 { color: #fff; }
  .cta--closing p { font-size: var(--fs-lead); }
  .cta--closing::before { content: ''; position: absolute; left: 0; top: 0; width: 120px; height: 4px; background: var(--red-600); }

  .cta--banner { padding-block: 2.5rem; background: var(--blue-600); color: #e6eef8; }
  .cta--banner h2 { color: #fff; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); }
  .cta--banner :global(.btn--quote) { box-shadow: none; }

  .cta--secondary { padding-block: 2.5rem; background: var(--blue-50); border-block: 1px solid var(--blue-100); }
  .cta--secondary h2 { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); }
</style>
