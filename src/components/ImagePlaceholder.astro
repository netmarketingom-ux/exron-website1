---
/**
 * Labelled image slot. Swap for a real photo later:
 *   <img src="/images/warehouse.jpg" alt="..." loading="lazy" />
 * Use licensed images only and never imply they show Exron's own projects.
 */
import Icon from './Icon.astro';
interface Props {
  label: string;           // suggested subject, e.g. "warehouse / logistics"
  alt?: string;            // suggested alt text for the final image
  ratio?: string;          // CSS aspect-ratio, e.g. "16/9"
  tone?: 'light' | 'dark';
  class?: string;
}
const { label, alt, ratio = '4/3', tone = 'light', class: className } = Astro.props;
---
<div
  class:list={['img-ph', `img-ph--${tone}`, className]}
  style={`aspect-ratio:${ratio}`}
  role="img"
  aria-label={`Image placeholder: ${label}`}
  data-alt={alt}
>
  <div class="img-ph__inner">
    <Icon name="image" size={28} />
    <span class="img-ph__tag">Image</span>
    <span class="img-ph__label">{label}</span>
  </div>
</div>

<style>
  .img-ph {
    position: relative; width: 100%; overflow: hidden; border-radius: var(--radius-lg);
    display: grid; place-items: center; text-align: center;
    background-color: var(--slate-100);
    background-image:
      repeating-linear-gradient(135deg, transparent 0 14px, rgba(11, 31, 58, 0.045) 14px 15px);
    border: 1px solid var(--slate-200); color: var(--slate-500);
  }
  .img-ph--dark {
    background-color: var(--navy-800);
    background-image:
      repeating-linear-gradient(135deg, transparent 0 14px, rgba(255, 255, 255, 0.05) 14px 15px);
    border-color: rgba(255, 255, 255, 0.1); color: #8ea4c2;
  }
  .img-ph__inner { display: flex; flex-direction: column; align-items: center; gap: 0.375rem; padding: 1rem; }
  .img-ph__tag { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8; }
  .img-ph__label { font-size: 0.9375rem; font-weight: 600; max-width: 26ch; line-height: 1.35; }
</style>
