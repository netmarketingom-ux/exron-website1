---
/**
 * Dot-matrix world map rendered at build time (no client-side JS, no external requests).
 * Land dots inside `primary` are highlighted (primary area of operations).
 * Optional labelled markers are placed by longitude/latitude.
 */
import { geoEquirectangular, geoContains } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';

interface Marker { label: string; lon: number; lat: number; primary?: boolean; }
interface Props {
  primary?: { lonMin: number; lonMax: number; latMin: number; latMax: number };
  markers?: Marker[];
  step?: number;
  tone?: 'dark' | 'light';
}
const {
  primary = { lonMin: 34, lonMax: 60, latMin: 12, latMax: 38 },
  markers = [],
  step = 2.4,
  tone = 'dark',
} = Astro.props;

const land = feature(land110 as any, (land110 as any).objects.land) as any;
const W = 1000, H = 480;
const projection = geoEquirectangular().scale(W / (2 * Math.PI)).translate([W / 2, H / 2 + 62]);

const dots: { x: number; y: number; hot: boolean }[] = [];
for (let lat = 78; lat >= -56; lat -= step) {
  for (let lon = -170; lon <= 180; lon += step) {
    if (!geoContains(land, [lon, lat])) continue;
    const [x, y] = projection([lon, lat])!;
    if (y < 0 || y > H) continue;
    const hot = lon >= primary.lonMin && lon <= primary.lonMax && lat >= primary.latMin && lat <= primary.latMax;
    dots.push({ x: +x.toFixed(1), y: +y.toFixed(1), hot });
  }
}
const pts = markers.map((m) => { const [x, y] = projection([m.lon, m.lat])!; return { ...m, x, y }; });
const r = step * 1.05;
const ys = dots.map((d) => d.y);
const top = Math.floor(Math.min(...ys) - 12), bottom = Math.ceil(Math.max(...ys) + 12);
const viewBox = `0 ${top} ${W} ${bottom - top}`;
---
<svg class:list={['map', `map--${tone}`]} viewBox={viewBox} role="img" aria-label="Map of operating and sourcing regions">
  <g class="map__land">
    {dots.filter((d) => !d.hot).map((d) => <circle cx={d.x} cy={d.y} r={r} />)}
  </g>
  <g class="map__hot">
    {dots.filter((d) => d.hot).map((d) => <circle cx={d.x} cy={d.y} r={r} />)}
  </g>
  {pts.map((p) => (
    <g class:list={['map__marker', p.primary && 'is-primary']} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
      {p.primary && <circle class="map__pulse" r="18" />}
      <circle class="map__pin" r={p.primary ? 7 : 5} />
      <text x={p.primary ? 14 : 11} y="4">{p.label}</text>
    </g>
  ))}
</svg>

<style>
  .map { width: 100%; height: auto; }
  .map--dark .map__land { fill: rgba(255, 255, 255, 0.2); }
  .map--light .map__land { fill: var(--navy-200); }
  .map__hot { fill: var(--red-300); }
  .map--light .map__hot { fill: var(--red-600); }
  .map__pin { fill: #fff; stroke: var(--navy-700); stroke-width: 2; }
  .map__marker.is-primary .map__pin { fill: var(--red-600); stroke: #fff; }
  .map__pulse { fill: rgba(232, 131, 143, 0.25); }
  .map__marker text {
    font-family: var(--font-mono); font-size: 15px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase;
    fill: #fff; paint-order: stroke; stroke: var(--navy-900); stroke-width: 4px; stroke-linejoin: round;
  }
  .map--light .map__marker text { fill: var(--navy-900); stroke: #fff; }
</style>
