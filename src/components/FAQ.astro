---
import { rich } from '../lib/site';
import Rich from './Rich.astro';
import SectionHead from './SectionHead.astro';
interface Item { q: string; a: string; }
interface Props { heading?: string; eyebrow?: string; items: Item[]; }
const { heading = 'Frequently asked questions', eyebrow = 'FAQ', items } = Astro.props;
---
<div class="faq">
  <SectionHead eyebrow={eyebrow} heading={heading} center />
  <div class="faq__list">
    {items.map((item, i) => (
      <details class="faq__item" open={i === 0}>
        <summary><h3 set:html={rich(item.q)} /><span class="faq__icon" aria-hidden="true"></span></summary>
        <div class="faq__answer" set:html={rich(item.a)} />
      </details>
    ))}
  </div>
</div>

<style>
  .faq__list { max-width: 820px; margin-inline: auto; display: grid; gap: 0.75rem; }
  .faq__item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .faq__item[open] { border-color: var(--slate-300); box-shadow: var(--shadow-sm); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.125rem 1.25rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.0625rem; }
  .faq__icon { position: relative; width: 20px; height: 20px; flex-shrink: 0; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 3px; right: 3px; top: 9px; height: 2px; background: var(--blue-600); transition: transform var(--transition); }
  .faq__icon::after { transform: rotate(90deg); }
  details[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__answer { padding: 0 1.25rem 1.25rem; color: var(--slate-600); }
</style>
