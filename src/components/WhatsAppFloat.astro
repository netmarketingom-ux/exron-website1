---
import Icon from './Icon.astro';
import ctas from '../data/ctas.json';
import { whatsappHref, isExternal } from '../lib/site';
const ext = isExternal(whatsappHref);
---
<a
  class="wa-float"
  href={whatsappHref}
  {...(ext ? { target: '_blank', rel: 'noopener' } : {})}
  aria-label={ctas.floating.label}
>
  <Icon name="whatsapp" size={26} />
  <span class="wa-float__label">{ctas.floating.label}</span>
</a>

<style>
  .wa-float {
    position: fixed; right: 16px; bottom: 16px; z-index: 90;
    display: inline-flex; align-items: center; gap: 0.5rem;
    height: 56px; padding: 0 1.125rem 0 0.875rem; border-radius: 999px;
    background: #1f8f4e; color: #fff; text-decoration: none; font-weight: 600; font-size: 0.9375rem;
    box-shadow: 0 8px 24px rgba(11, 31, 58, 0.25);
    transition: background var(--transition), transform var(--transition);
  }
  .wa-float:hover { background: #18733e; color: #fff; transform: translateY(-2px); }
  @media (min-width: 768px) {
    .wa-float { width: 56px; padding: 0; justify-content: center; right: 24px; bottom: 24px; }
    .wa-float__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
</style>
