---
/**
 * Shows an optimized photo when one has been uploaded through the CMS,
 * otherwise a neutral placeholder describing the intended shot.
 */
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/content';

interface Props {
  image?: string;
  alt?: string;
  note: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const {
  image, alt = '', note, ratio = '4 / 3',
  widths = [480, 800, 1200], sizes = '(min-width: 1024px) 50vw, 100vw',
  priority = false, class: className,
} = Astro.props;
const src = resolveImage(image);
---
{src ? (
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class:list={['photo', className]}
    style={`aspect-ratio:${ratio}`}
  />
) : (
  <figure class:list={['photo-slot', className]} style={`aspect-ratio:${ratio}`}>
    <figcaption>{note}</figcaption>
  </figure>
)}

<style>
  :global(.photo) { width: 100%; height: auto; object-fit: cover; }
  :global(picture) { display: block; }
  .photo-slot {
    margin: 0; display: flex; align-items: flex-end;
    width: 100%; background: var(--paper); border: 1px solid var(--rule);
  }
  .photo-slot figcaption {
    padding: 1rem 1.25rem; font-family: var(--font-mono); font-size: 0.875rem;
    letter-spacing: 0.04em; line-height: 1.5; color: var(--steel); max-width: 40ch;
  }
</style>
