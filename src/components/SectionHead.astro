---
import { rich } from '../lib/site';
import Rich from './Rich.astro';
interface Props { eyebrow?: string; heading: string; intro?: string; center?: boolean; id?: string; }
const { eyebrow, heading, intro, center = false, id } = Astro.props;
---
<div class:list={['section-head', center && 'section-head--center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}><Rich text={heading} /></h2>
  {intro && <p class="lead" set:html={rich(intro)} />}
</div>
