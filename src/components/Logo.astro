---
import { Image } from 'astro:assets';
import logo from '../assets/brand/exron-logo.png';
import logoWhite from '../assets/brand/exron-logo-white.png';
import { site } from '../lib/content';

interface Props { inverse?: boolean; height?: number; link?: boolean }
const { inverse = false, height = 40, link = true } = Astro.props;
const src = inverse ? logoWhite : logo;
const width = Math.round((src.width / src.height) * height);
const Tag = link ? 'a' : 'span';
---
<Tag class="logo" style={`--logo-h:${height}px`} href={link ? '/' : undefined} aria-label={link ? `${site.name} home` : undefined}>
  <Image
    src={src}
    alt={link ? '' : site.name}
    width={width}
    height={height}
    densities={[1, 2]}
    format="webp"
    loading="eager"
  />
</Tag>

<style>
  .logo { display: inline-flex; align-items: center; flex-shrink: 0; }
  .logo :global(img) { height: var(--logo-h); width: auto; }
</style>
