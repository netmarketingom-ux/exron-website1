---
import Logo from './Logo.astro';
import VendorList from './VendorList.astro';
import { site, rich, isSet, procurementEmail, telHref, whatsappHref, visibleVendorFields } from '../lib/content';

const columns = [
  {
    title: 'Company',
    links: [
      { label: 'About Exron', href: '/about/' },
      { label: 'Capabilities', href: '/capabilities/' },
      { label: 'Industries We Serve', href: '/industries/' },
    ],
  },
  {
    title: 'Government',
    links: [
      { label: 'Government Contracting', href: '/government-contracting/' },
      { label: 'Capability Statement', href: '/government-contracting/#capability-statement' },
      { label: 'Submit an RFQ', href: '/submit-rfq/' },
    ],
  },
];

const contact = [
  { label: 'Procurement', value: site.procurement_email, href: procurementEmail && `mailto:${procurementEmail}` },
  { label: 'Phone', value: site.phone, href: telHref },
  { label: 'WhatsApp', value: site.whatsapp, href: whatsappHref },
  { label: 'Address', value: site.address, href: '' },
];
---
<footer class="site-footer on-navy">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo inverse height={44} />
        <p>{site.description}</p>
      </div>

      {columns.map((col) => (
        <nav class="site-footer__col" aria-label={col.title}>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}

      <div class="site-footer__col">
        <h2>Contact</h2>
        <dl class="site-footer__contact">
          {contact.map((c) => (
            <div>
              <dt>{c.label}</dt>
              <dd>
                {isSet(c.value) && c.href
                  ? <a href={c.href}>{c.value}</a>
                  : <span set:html={rich(c.value)} />}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    {visibleVendorFields.length > 0 && (
      <div class="site-footer__vendor">
        <VendorList fields={visibleVendorFields} compact />
      </div>
    )}

    <div class="site-footer__bottom">
      <p class="site-footer__disclaimer">{site.disclaimer}</p>
      <ul class="site-footer__legal">
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Use</a></li>
        <li>© {site.copyright_year} {site.legal_name}</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-deep); color: var(--on-navy-muted); padding-block: 4rem 2rem; font-size: 0.9375rem; }
  .site-footer a { color: #fff; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; color: #fff; }
  .site-footer__top { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  .site-footer__brand p { margin-top: 1.25rem; max-width: 34ch; }
  .site-footer h2 {
    margin-bottom: 1rem; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-navy-muted);
  }
  .site-footer ul { list-style: none; display: grid; gap: 0.6rem; }
  .site-footer__contact { margin: 0; display: grid; gap: 0.75rem; }
  .site-footer__contact dt { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .site-footer__contact dd { margin: 0.15rem 0 0; color: #fff; overflow-wrap: anywhere; }
  .site-footer__vendor { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--rule-on-navy); }
  .site-footer__bottom { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule-on-navy); display: grid; gap: 1rem; font-size: 0.875rem; }
  .site-footer__disclaimer { max-width: 80ch; }
  .site-footer__legal { display: flex !important; flex-wrap: wrap; gap: 0.5rem 1.5rem !important; }

  @media (min-width: 640px) {
    .site-footer__top { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .site-footer__top { grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: 3rem; }
  }
</style>
