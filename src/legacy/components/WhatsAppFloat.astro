---
import Icon from './Icon.astro';
import { whatsappHref, isExternal } from '../lib/site';
const ext = isExternal(whatsappHref);
---
<a
  class="wa-float"
  href={whatsappHref}
  {...(ext ? { target: '_blank', rel: 'noopener' } : {})}
  aria-label="Chat with Exron Global on WhatsApp"
  title="WhatsApp"
>
  <Icon name="whatsapp" size={26} />
</a>

<style>
  .wa-float {
    position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 90;
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: #1f7a46; color: #fff; text-decoration: none;
    box-shadow: 0 8px 24px rgba(34, 33, 73, 0.28);
    transition: background var(--transition), transform var(--transition);
  }
  .wa-float:hover { background: #18633a; color: #fff; transform: translateY(-2px); }
  @media (min-width: 768px) { .wa-float { right: 24px; bottom: 24px; width: 56px; height: 56px; } }
</style>
