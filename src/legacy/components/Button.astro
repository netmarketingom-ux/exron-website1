---
import Icon from './Icon.astro';
import { resolveHref, isExternal } from '../lib/site';

interface Props {
  href: string;
  variant?: 'primary' | 'quote' | 'secondary' | 'ghost' | 'whatsapp';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconAfter?: string;
  class?: string;
}
const { href, variant = 'primary', size = 'md', icon, iconAfter, class: className } = Astro.props;
const url = resolveHref(href);
const ext = isExternal(url);
---
<a
  href={url}
  class:list={['btn', `btn--${variant}`, size !== 'md' && `btn--${size}`, className]}
  {...(ext ? { target: '_blank', rel: 'noopener' } : {})}
>
  {icon && <Icon name={icon} />}
  <slot />
  {iconAfter && <Icon name={iconAfter} />}
</a>
