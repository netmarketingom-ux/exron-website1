---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { rich, site, webpSrcset } from '../lib/site';
import { loadPage } from '../lib/page';
import raw from '../content/pages/home.md?raw';

const d = loadPage(raw);
const group = d.coverage.group;
---
<BaseLayout title={d.seoTitle} description={d.seoDescription}>

  <!-- Section 1: Main introduction -->
  <section class="intro-hero" aria-labelledby="home-title">
    <picture><source type="image/webp" srcset={webpSrcset('/images/photos/home-banner.jpg', [1000, 2000])} sizes="100vw" /><img class="intro-hero__bg" src="/images/photos/home-banner.jpg" alt="" fetchpriority="high" decoding="async" /></picture>
    <div class="container intro-hero__grid">
      <div>
        <h1 id="home-title">{d.hero.heading.replace(' & ', '\u00a0& ')}</h1>
        <p class="intro-hero__sub">{d.hero.subheading}</p>
        <p class="intro-hero__text">{d.hero.text}</p>
        <div class="btn-row btn-row--stack">
          <Button href={d.hero.buttons[0].href} variant="quote" size="lg">{d.hero.buttons[0].label}</Button>
          <Button href={d.hero.buttons[1].href} variant="ghost" size="lg">{d.hero.buttons[1].label}</Button>
        </div>
      </div>

      <form class="quick" action="/submit-rfq/" method="get" aria-labelledby="quick-title">
        <h2 id="quick-title">{d.hero.quick.heading}</h2>
        <p class="quick__text">{d.hero.quick.text}</p>
        <label for="q-org">Organization</label>
        <input id="q-org" name="organization" type="text" maxlength="200" autocomplete="organization" />
        <label for="q-email">Email</label>
        <input id="q-email" name="email" type="email" maxlength="200" autocomplete="email" />
        <label for="q-sol">RFQ or solicitation number <span class="quick__opt">(optional)</span></label>
        <input id="q-sol" name="solicitation_number" type="text" maxlength="100" />
        <label for="q-desc">Requirement <span class="quick__opt">(optional)</span></label>
        <textarea id="q-desc" name="description" rows="2" maxlength="2000"></textarea>
        <button class="btn btn--quote quick__btn" type="submit">{d.hero.quick.button}</button>
      </form>
    </div>
  </section>

  <!-- Section 2: Company overview -->
  <section class="section" id="overview">
    <div class="container media-row">
      <div>
        <h2>{d.overview.heading}</h2>
        {d.overview.paragraphs.map((p: string) => <p class="lead">{p}</p>)}
        <h3 class="serve__title">{d.overview.serveHeading}</h3>
        <ul class="serve">{d.overview.serve.map((c: string) => <li>{c}</li>)}</ul>
        <Button href={d.overview.button.href} variant="secondary">{d.overview.button.label}</Button>
      </div>
      <picture><source type="image/webp" srcset={webpSrcset('/images/photos/procurement-partner.jpg', [600, 1200])} sizes="(min-width: 960px) 600px, 100vw" /><img class="media-row__img" src="/images/photos/procurement-partner.jpg" alt="A hand signing a document" loading="lazy" decoding="async" width="1200" height="900" /></picture>
    </div>
  </section>

  <!-- Section 3: Capabilities overview -->
  <section class="section section--alt" id="capabilities">
    <div class="container media-row media-row--flip">
      <picture><source type="image/webp" srcset={webpSrcset('/images/photos/supply-capabilities.jpg', [600, 1200])} sizes="(min-width: 960px) 600px, 100vw" /><img class="media-row__img" src="/images/photos/supply-capabilities.jpg" alt="Industrial pipework and valves" loading="lazy" decoding="async" width="1200" height="900" /></picture>
      <div>
        <h2>{d.capabilities.heading}</h2>
        {d.capabilities.paragraphs.map((p: string) => <p class="lead">{p}</p>)}
        <ul class="cat-list">
          {d.capabilities.categories.map((c: string) => <li>{c}</li>)}
        </ul>
        <p class="cat-services"><strong>Operational services:</strong> {d.capabilities.services}</p>
        <Button href={d.capabilities.button.href} variant="secondary">{d.capabilities.button.label}</Button>
      </div>
    </div>
  </section>

  <!-- Section 4: Competitive strengths -->
  <section class="section" id="strengths">
    <div class="container">
      <h2 class="section-title">{d.strengths.heading}</h2>
      <ul class="strengths">
        {d.strengths.items.map((s: any) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Section 5: Geographic coverage and group affiliation -->
  <section class="section section--dark" id="coverage">
    <div class="container two-col two-col--even">
      <div>
        <h2>{d.coverage.heading}</h2>
        {d.coverage.paragraphs.map((p: string) => <p class="lead">{p}</p>)}
      </div>
      <div class="coverage__side">
        <picture><source type="image/webp" srcset={webpSrcset('/images/photos/regional-presence.jpg', [600, 1200])} sizes="(min-width: 960px) 600px, 100vw" /><img class="coverage__img" src="/images/photos/regional-presence.jpg" alt="Abu Dhabi skyline at night" loading="lazy" decoding="async" width="1200" height="800" /></picture>
      <aside class="group" aria-label={group.label}>
        <h3 class="group__label">{group.label}</h3>
        {group.logo && <img class="group__logo" src={group.logo} alt={`${site.groupName} logo`} loading="lazy" />}
        <p set:html={rich(group.statement)} />
        {group.website && <a class="link-arrow" href={group.website} target="_blank" rel="noopener">Group website</a>}
      </aside>
      </div>
    </div>
  </section>

  <!-- Section 6: RFQ submission -->
  <section class="section section--alt" id="rfq">
    <div class="container rfq-close">
      <h2>{d.rfq.heading}</h2>
      <p class="lead">{d.rfq.text}</p>
      <Button href={d.rfq.button.href} variant="quote" size="lg">{d.rfq.button.label}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* Section 1 */
  .intro-hero { position: relative; overflow: hidden; background: var(--navy-700); color: var(--on-dark-2); padding-block: clamp(3rem, 2rem + 4vw, 5.5rem); }
  .intro-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .intro-hero::before { content: ""; position: absolute; inset: 0; z-index: 1; background: rgba(16, 35, 56, 0.74); }
  .intro-hero__grid { position: relative; z-index: 2; }
  .intro-hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  .intro-hero__grid > * { min-width: 0; }
  @media (min-width: 1024px) { .intro-hero__grid { grid-template-columns: 1.35fr 0.85fr; gap: 4rem; } }
  .intro-hero h1 { color: #fff; font-size: var(--fs-display); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 1rem; max-width: 20ch; text-wrap: balance; }
  .intro-hero__sub { margin: 0 0 1.25rem; font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem); font-weight: 600; line-height: 1.35; color: #fff; }
  .intro-hero__text { font-size: var(--fs-lead); line-height: 1.6; max-width: 58ch; margin: 0 0 2rem; color: var(--on-dark-2); }

  .quick { background: #fff; color: var(--ink-700); border-radius: var(--radius-lg); padding: 1.75rem; display: grid; gap: 0.4rem; }
  .quick h2 { font-size: 1.375rem; margin: 0; color: var(--ink-900); }
  .quick__text { margin: 0.25rem 0 0.5rem; font-size: 0.9375rem; color: var(--ink-500); }
  .quick label { margin-top: 0.5rem; font-weight: 600; font-size: 0.9375rem; color: var(--ink-900); }
  .quick__opt { font-weight: 400; color: var(--ink-500); }
  .quick input, .quick textarea {
    width: 100%; min-height: 46px; padding: 0.6rem 0.8rem; font: inherit; color: var(--ink-900);
    background: #fff; border: 1px solid var(--line-strong); border-radius: var(--radius);
  }
  .quick textarea { min-height: 72px; resize: vertical; }
  .quick input:focus-visible, .quick textarea:focus-visible { outline: 3px solid var(--navy-700); outline-offset: 0; box-shadow: none; }
  .quick__btn { width: 100%; margin-top: 1rem; }

  /* Sections 2, 3 and 5: heading beside its text on wide screens */
  .two-col { display: grid; gap: 1.25rem 4rem; align-items: start; }
  .two-col > * { min-width: 0; }
  @media (min-width: 960px) {
    .two-col { grid-template-columns: 0.8fr 1.2fr; }
    .two-col--even { grid-template-columns: 1fr 1fr; }
  }
  .two-col h2 { margin: 0; }
  .two-col .lead { margin-bottom: 1rem; max-width: 64ch; }
  .two-col :global(.btn) { margin-top: 1rem; }

  .cat-list { list-style: none; display: grid; margin: 1.5rem 0 0.5rem; border-top: 1px solid var(--line); }
  @media (min-width: 640px) { .cat-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; } }
  .cat-list li { padding: 0.8rem 0; border-bottom: 1px solid var(--line); font-weight: 500; color: var(--ink-900); }

  /* Sections 2 and 3: text beside a photo */
  .media-row { display: grid; gap: 2rem 4rem; align-items: center; }
  .media-row > * { min-width: 0; }
  @media (min-width: 960px) { .media-row { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 959px) { .media-row--flip > picture { order: 2; } }
  .media-row h2 { margin: 0 0 1.25rem; }
  .media-row .lead { margin-bottom: 1rem; }
  .media-row :global(.btn) { margin-top: 1rem; }
  .media-row__img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); display: block; }
  .coverage__img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-lg); display: block; }
  .coverage__side { display: grid; gap: 1.5rem; }

  .serve__title { font-size: 1rem; font-weight: 600; margin: 1.5rem 0 0.5rem; color: var(--ink-900); }
  .serve { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .serve li { position: relative; padding-left: 1rem; color: var(--ink-700); }
  .serve li::before { content: ""; position: absolute; left: 0; top: 0.7em; width: 6px; height: 2px; background: var(--navy-700); }
  .cat-services { margin: 1rem 0 0; color: var(--ink-700); }
  .cat-services strong { color: var(--ink-900); font-weight: 600; }

  /* Section 4 */
  .section-title { margin-bottom: 2rem; }
  .strengths { list-style: none; display: grid; gap: 2rem 3rem; }
  @media (min-width: 768px) { .strengths { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .strengths { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .strengths li { padding-top: 1.25rem; border-top: 2px solid var(--navy-700); }
  .strengths h3 { font-size: var(--fs-h3); margin: 0 0 0.5rem; }
  .strengths p { margin: 0; color: var(--ink-700); }

  /* Section 5 */
  #coverage .lead { color: var(--on-dark-2); }
  #coverage h2 { margin-bottom: 1.25rem; }
  .group { border: 1px solid var(--navy-600); background: var(--navy-800); padding: 1.75rem; color: var(--on-dark-2); }
  .group__label { margin: 0 0 0.75rem; font-size: 1rem; font-weight: 600; color: var(--on-dark-3) !important; }
  .group__logo { max-height: 56px; width: auto; margin-bottom: 1rem; }
  .group p { margin: 0; }
  .group :global(.link-arrow) { margin-top: 1rem; }

  /* Section 6 */
  .rfq-close > * { max-width: 760px; }
  .rfq-close .lead { margin: 0.75rem 0 1.75rem; }
</style>
