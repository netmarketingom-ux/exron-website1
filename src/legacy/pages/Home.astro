---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import DataCard from '../components/DataCard.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CoverageMap from '../components/CoverageMap.astro';
import { rich, site } from '../lib/site';
import { loadPage } from '../lib/page';
import raw from '../content/pages/home.md?raw';
import capsRaw from '../content/pages/capabilities.md?raw';

const d = loadPage(raw);
// The category count comes from the Capabilities page, so the two always agree.
const categories = String(loadPage(capsRaw).categories.items.length);
const figures = d.hero.figures.map((f: any) => ({ ...f, value: f.value.replace('{categories}', categories) }));
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<BaseLayout title={d.seoTitle} description={d.seoDescription}>

  <!-- 01 Introduction -->
  <section class="intro-hero" aria-labelledby="home-title">
    <div class="intro-hero__stripes" aria-hidden="true"></div>
    <div class="container intro-hero__grid">
      <div>
        <p class="intro-hero__kicker">{d.hero.kicker}</p>
        <h1 id="home-title">{d.hero.heading.map((line: string) => <span>{line}</span>)}</h1>
        <p class="intro-hero__positioning">{d.hero.positioning}</p>
        <p class="intro-hero__text" set:html={rich(d.hero.text)} />
        <div class="btn-row btn-row--stack">
          <Button href={d.hero.buttons[0].href} variant="quote" size="lg" icon="file">{d.hero.buttons[0].label}</Button>
          <Button href={d.hero.buttons[1].href} variant="ghost" size="lg" iconAfter="arrow-right">{d.hero.buttons[1].label}</Button>
        </div>
      </div>

      <form class="quick" action="/submit-rfq/" method="get" aria-labelledby="quick-title">
        <p class="quick__label"><span class="dot" aria-hidden="true"></span>{d.hero.quick.label}</p>
        <div class="quick__body">
          <h2 id="quick-title">{d.hero.quick.heading}</h2>
          <p class="quick__text">{d.hero.quick.text}</p>
          <label for="q-org">Organization</label>
          <input id="q-org" name="organization" type="text" maxlength="200" autocomplete="organization" />
          <label for="q-email">Official email</label>
          <input id="q-email" name="email" type="email" maxlength="200" autocomplete="email" />
          <label for="q-sol">RFQ or solicitation number <span class="quick__opt">(optional)</span></label>
          <input id="q-sol" name="solicitation_number" type="text" maxlength="100" class="mono" />
          <label for="q-desc">What do you need? <span class="quick__opt">(optional)</span></label>
          <textarea id="q-desc" name="description" rows="2" maxlength="2000"></textarea>
          <button class="btn btn--quote btn--lg quick__btn" type="submit">{d.hero.quick.button}<Icon name="arrow-right" /></button>
          <p class="quick__note"><Icon name="check-circle" size={18} /><span set:html={rich(d.hero.quick.note)} /></p>
        </div>
      </form>
    </div>
  </section>

  <section class="figures" aria-label="Exron Global in figures">
    <dl class="container figures__grid">
      {figures.map((f: any) => (
        <div><dt>{f.label}</dt><dd class:list={[!/^\d+$/.test(f.value) && 'is-text']}>{f.value}</dd></div>
      ))}
    </dl>
  </section>

  <!-- 02 Company overview -->
  <section class="section" id="overview">
    <div class="container split split--wide-left">
      <div>
        <SectionHead eyebrow={d.overview.eyebrow} heading={d.overview.heading} />
        {d.overview.paragraphs.map((p: string, i: number) => <p class:list={[i === 0 && 'lead']} set:html={rich(p)} />)}
        <a class="link-arrow" href={d.overview.link.href}>{d.overview.link.label}<Icon name="arrow-right" /></a>
      </div>
      <DataCard title={d.overview.profile.title} rows={d.overview.profile.rows}>
        <a class="link-arrow" href={d.overview.profile.link.href}>{d.overview.profile.link.label}<Icon name="arrow-right" /></a>
      </DataCard>
    </div>
  </section>

  <!-- 03 Capabilities -->
  <section class="section section--alt" id="capabilities">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={d.capabilities.eyebrow} heading={d.capabilities.heading} intro={d.capabilities.lead} />
        <a class="link-arrow head-row__link" href={d.capabilities.link.href}>{d.capabilities.link.label}<Icon name="arrow-right" /></a>
      </div>
      <FeatureGrid items={d.capabilities.items} columns={3} />
    </div>
  </section>

  <!-- 04 Competitive strengths -->
  <section class="section" id="strengths">
    <div class="container">
      <SectionHead eyebrow={d.strengths.eyebrow} heading={d.strengths.heading} />
      <ol class="strengths">
        {d.strengths.items.map((s: any, i: number) => (
          <li>
            <span class="strengths__num">{pad(i)}</span>
            <h3 set:html={rich(s.title)} />
            <p set:html={rich(s.text)} />
          </li>
        ))}
      </ol>
      <p class="notice strengths__notice"><Icon name="shield" /><span set:html={rich(d.strengths.notice)} /></p>
    </div>
  </section>

  <!-- 05 Geographic coverage & group affiliation -->
  <section class="section section--deep cover" id="coverage">
    <div class="container cover__grid">
      <div>
        <SectionHead eyebrow={d.coverage.eyebrow} heading={d.coverage.heading} intro={d.coverage.text} />
        <div class="cover__map"><CoverageMap markers={d.coverage.markers} /></div>
        <dl class="cover__rows">
          {d.coverage.rows.map((r: any) => <div><dt>{r.k}</dt><dd set:html={rich(r.v)} /></div>)}
        </dl>
      </div>
      <aside class="group-card" aria-labelledby="group-title">
        <p class="group-card__label">{d.coverage.group.label}</p>
        {d.coverage.group.logo && <img class="group-card__logo" src={d.coverage.group.logo} alt={`${site.groupName} logo`} loading="lazy" />}
        <h3 id="group-title" set:html={rich(d.coverage.group.heading)} />
        <p set:html={rich(d.coverage.group.text)} />
        <p class="group-card__notice"><Icon name="shield" size={18} /><span set:html={rich(d.coverage.group.notice)} /></p>
        <div class="group-card__links">
          <a class="link-arrow" href={d.coverage.group.link.href}>{d.coverage.group.link.label}<Icon name="arrow-right" /></a>
          {d.coverage.group.website && <a class="link-arrow" href={d.coverage.group.website} target="_blank" rel="noopener">Group website<Icon name="arrow-right" /></a>}
        </div>
      </aside>
    </div>
  </section>

  <!-- 06 RFQ submission -->
  <section class="section rfq-close" id="rfq">
    <div class="container rfq-close__grid">
      <div>
        <SectionHead eyebrow={d.rfq.eyebrow} heading={d.rfq.heading} intro={d.rfq.text} />
        <div class="btn-row btn-row--stack">
          <Button href={d.rfq.buttons[0].href} variant="quote" size="lg" icon="file">{d.rfq.buttons[0].label}</Button>
          <Button href={d.rfq.buttons[1].href} variant="secondary" size="lg">{d.rfq.buttons[1].label}</Button>
        </div>
        <p class="notice notice--warn rfq-close__security"><Icon name="shield" /><span><strong>Secure transmission.</strong> <span set:html={rich(d.rfq.security)} /></span></p>
      </div>
      <div class="data-card">
        <p class="data-card__title">{d.rfq.checklistTitle}</p>
        <ul class="check-list rfq-close__list">
          {d.rfq.checklist.map((c: string) => <li><Icon name="check" />{c}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 01 Introduction (Option C foundation) */
  .intro-hero {
    position: relative; overflow: hidden; color: var(--on-dark-2);
    background: linear-gradient(160deg, var(--navy-800) 0%, var(--navy-900) 60%, var(--navy-950) 100%);
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
    border-top: 4px solid var(--red-600);
  }
  .intro-hero__stripes {
    position: absolute; inset: 0 0 0 auto; width: 45%; pointer-events: none;
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0 28px, transparent 28px 56px);
    mask-image: linear-gradient(90deg, transparent, #000 60%);
  }
  .intro-hero__grid { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  .intro-hero__grid > * { min-width: 0; }
  @media (min-width: 1024px) { .intro-hero__grid { grid-template-columns: 1.3fr 0.9fr; gap: 4rem; } }
  .intro-hero__kicker {
    margin: 0 0 1rem; font-family: var(--font-display); font-stretch: 118%; font-weight: 800;
    font-size: 0.9375rem; letter-spacing: 0.22em; text-transform: uppercase; color: #fff;
    display: inline-flex; align-items: center; gap: 0.75rem;
  }
  .intro-hero__kicker::before { content: ''; width: 32px; height: 3px; background: var(--red-600); }
  .intro-hero h1 { color: #fff; font-size: clamp(2.125rem, 1.4rem + 2.8vw, 3.75rem); line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 1.5rem; }
  .intro-hero h1 span { display: block; }
  .intro-hero__positioning {
    margin: 0 0 1.25rem; padding-left: 1rem; border-left: 3px solid var(--red-600);
    font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 600;
    font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.3125rem); line-height: 1.35; color: #fff; max-width: 34ch;
  }
  .intro-hero__text { font-size: var(--fs-lead); line-height: 1.6; max-width: 56ch; margin-bottom: 2rem; color: var(--on-dark-2); }

  .quick { background: #fff; color: var(--ink-700); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); overflow: hidden; }
  .quick__label {
    display: flex; align-items: center; gap: 0.5rem; margin: 0; padding: 0.75rem 1.5rem;
    background: var(--navy-700); color: #fff; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .quick__label .dot { width: 8px; height: 8px; border-radius: 50%; background: #3ccf7a; box-shadow: 0 0 0 3px rgba(60, 207, 122, 0.25); }
  .quick__body { padding: 1.5rem; display: grid; gap: 0.4rem; }
  .quick h2 { font-size: 1.375rem; margin: 0; }
  .quick__text { margin: 0.25rem 0 0.5rem; font-size: 0.9375rem; color: var(--ink-500); }
  .quick label { margin-top: 0.5rem; font-weight: 600; font-size: 0.9375rem; color: var(--ink-900); }
  .quick__opt { font-weight: 400; color: var(--ink-500); }
  .quick input, .quick textarea {
    width: 100%; min-height: 46px; padding: 0.6rem 0.8rem; font: inherit; color: var(--ink-900);
    background: #fff; border: 1px solid var(--line-strong); border-radius: var(--radius);
  }
  .quick textarea { min-height: 72px; resize: vertical; }
  .quick input.mono { font-family: var(--font-mono); }
  .quick input:focus-visible, .quick textarea:focus-visible { outline: 3px solid var(--navy-700); outline-offset: 0; box-shadow: none; }
  .quick__btn { width: 100%; margin-top: 1rem; }
  .quick__note { display: flex; gap: 0.5rem; align-items: flex-start; margin: 0.75rem 0 0; padding-top: 0.875rem; border-top: 1px solid var(--line); font-size: 0.875rem; font-weight: 600; color: var(--navy-700); }
  .quick__note :global(svg) { color: #1f7a46; flex-shrink: 0; margin-top: 0.1rem; }

  .figures { background: var(--navy-700); border-bottom: 1px solid var(--navy-800); }
  .figures__grid { display: grid; grid-template-columns: 1fr; margin-inline: auto; }
  .figures__grid > div { display: flex; flex-direction: column-reverse; gap: 0.35rem; padding: 1.5rem 1rem 1.5rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .figures dd { margin: 0; font-family: var(--font-mono); font-size: clamp(1.875rem, 1.4rem + 1.8vw, 2.75rem); font-weight: 500; line-height: 1; color: #fff; }
  .figures dd.is-text { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 700; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); }
  .figures dt { font-size: 0.9375rem; color: var(--on-dark-2); max-width: 24ch; }
  @media (min-width: 900px) {
    .figures__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .figures__grid > div { border-bottom: 0; padding: 2rem 1.5rem; border-left: 1px solid rgba(255, 255, 255, 0.12); }
    .figures__grid > div:first-child { border-left: 0; padding-left: 0; }
  }

  /* 02 Overview */
  #overview :global(.data-card .link-arrow) { display: inline-flex; margin-top: 1.25rem; }
  #overview .link-arrow { margin-top: 0.5rem; }

  /* 03 Capabilities */
  .head-row { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .head-row :global(.section-head) { margin-bottom: 0; }
  @media (min-width: 900px) { .head-row { grid-template-columns: 1fr auto; align-items: end; gap: 3rem; } }
  #capabilities :global(.feature-grid > li) { grid-template-columns: auto 1fr; align-items: center; column-gap: 1rem; padding: 1.5rem; }
  #capabilities :global(.feature-grid h3) { margin: 0; font-size: 1.0625rem; }
  #capabilities :global(.feature-grid .link-arrow) { grid-column: 1 / -1; font-size: 0.875rem; }

  /* 04 Strengths (Option A numbering, Option B whitespace) */
  .strengths { list-style: none; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (min-width: 768px) { .strengths { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .strengths li { background: #fff; padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem); display: grid; gap: 0.75rem; align-content: start; }
  .strengths__num { font-family: var(--font-mono); font-size: 1.5rem; color: var(--red-600); line-height: 1; }
  .strengths h3 { font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.5rem); margin: 0; }
  .strengths p { margin: 0; color: var(--ink-700); max-width: 52ch; }
  .strengths__notice { margin-top: 1.5rem; }

  /* 05 Coverage & group */
  .cover { overflow: hidden; }
  .cover__grid { display: grid; gap: 3rem; align-items: start; }
  .cover__grid > * { min-width: 0; }
  @media (min-width: 1024px) { .cover__grid { grid-template-columns: 1.25fr 0.75fr; gap: 4rem; } }
  .cover__map { margin: 0 calc(var(--gutter) * -1) 1.5rem; }
  @media (min-width: 768px) { .cover__map { margin-inline: 0; } }
  .cover__rows { display: grid; gap: 1px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.12); margin: 0; }
  @media (min-width: 640px) { .cover__rows { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cover__rows > div { background: var(--navy-900); padding: 1.1rem 1.25rem; display: grid; gap: 0.35rem; align-content: start; }
  .cover__rows dt { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--red-300); }
  .cover__rows dd { margin: 0; color: #fff; font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 600; font-size: 1rem; }
  .group-card { background: #fff; color: var(--ink-700); border-top: 4px solid var(--red-600); padding: 2rem; display: grid; gap: 1rem; border-radius: var(--radius-lg); }
  .group-card__label { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy-700); }
  .group-card h3 { margin: 0; font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem); color: var(--ink-900); }
  .group-card p { margin: 0; }
  .group-card__notice { display: flex; gap: 0.5rem; align-items: flex-start; padding: 0.875rem 1rem; background: var(--navy-50); border-left: 3px solid var(--navy-700); font-size: 0.875rem; }
  .group-card__notice :global(svg) { color: var(--navy-700); flex-shrink: 0; margin-top: 0.1rem; }
  .group-card :global(.link-arrow) { color: var(--navy-700); }
  .group-card__logo { max-height: 56px; width: auto; }
  .group-card__links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }

  /* 06 RFQ submission */
  .rfq-close { border-top: 4px solid var(--red-600); background: var(--paper); }
  .rfq-close__grid { display: grid; gap: 3rem; align-items: start; }
  .rfq-close__grid > * { min-width: 0; }
  @media (min-width: 1024px) { .rfq-close__grid { grid-template-columns: 1.15fr 0.85fr; gap: 4rem; } }
  .rfq-close__security { margin-top: 2rem; }
  .rfq-close__list { padding: 1.5rem; font-size: 0.9375rem; }
</style>
