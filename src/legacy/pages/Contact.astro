---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import { rich, site, isSet, telHref, whatsappHref } from '../lib/site';
import { loadPage } from '../lib/page';
import raw from '../content/pages/contact.md?raw';

const d = loadPage(raw);
// Link the values that have been filled in.
const linkFor: Record<string, string | undefined> = {
  'RFQs & procurement': isSet(site.procurementEmail) ? `mailto:${site.procurementEmail}` : undefined,
  'General email': `mailto:${site.email}`,
  Phone: isSet(site.phone) ? telHref : undefined,
  WhatsApp: isSet(site.whatsapp) ? whatsappHref : undefined,
};
const rows = d.details.rows.map((r: any) => {
  const href = linkFor[r.k];
  return href ? { ...r, href } : r;
});
---
<BaseLayout title={d.seoTitle} description={d.seoDescription}>
  <PageHero eyebrow={d.hero.eyebrow} title={d.hero.title} lead={d.hero.lead} buttons={d.hero.buttons} crumb="Contact" />

  <section class="section section--alt">
    <div class="container">
      <FeatureGrid items={d.routes} columns={3} />
    </div>
  </section>

  <section class="section" id="inquiry">
    <div class="container contact-grid">
      <div id="contact-details" class="contact-details">
        <div class="data-card">
          <p class="data-card__title">{d.details.title}</p>
          <dl>
            {rows.map((r: any) => (
              <div>
                <dt>{r.k}</dt>
                <dd>{r.href ? <a href={r.href} set:html={rich(r.v)} /> : <span set:html={rich(r.v)} />}</dd>
              </div>
            ))}
          </dl>
        </div>
        <p class="notice notice--warn"><Icon name="shield" /><span><strong>Secure transmission.</strong> <span set:html={rich(d.security)} /></span></p>
      </div>
      <div class="form-scope">
        <SectionHead eyebrow={d.form.eyebrow} heading={d.form.heading} intro={d.form.text} />
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; gap: 3rem; align-items: start; }
  .contact-grid > * { min-width: 0; }
  @media (min-width: 1024px) { .contact-grid { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; } }
  .contact-details { display: grid; gap: 1.5rem; }
</style>
