---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DataCard from '../components/DataCard.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { rich } from '../lib/site';
import { loadPage } from '../lib/page';
import raw from '../content/pages/about.md?raw';

const d = loadPage(raw);
const divisions = [d.divisions.primary, d.divisions.secondary];
---
<BaseLayout title={d.seoTitle} description={d.seoDescription}>
  <PageHero eyebrow={d.hero.eyebrow} title={d.hero.title} lead={d.hero.lead} buttons={d.hero.buttons} crumb="About Exron">
    <DataCard slot="aside" title={d.hero.profile.title} rows={d.hero.profile.rows} />
  </PageHero>

  <section class="section">
    <div class="container split split--wide-left">
      <div>
        <SectionHead eyebrow={d.who.eyebrow} heading={d.who.heading} />
        {d.who.paragraphs.map((p: string) => <p class="lead" set:html={rich(p)} />)}
      </div>
      <ImagePlaceholder label={d.who.image.label} alt={d.who.image.alt} ratio="4/3" />
    </div>
  </section>

  <section class="section section--alt" id="experience">
    <div class="container split">
      <div class="about-exp__media">
        <ImagePlaceholder label="Exron Global management team (real photograph)" alt="Exron Global management team" ratio="1/1" />
        <p class="about-exp__team" set:html={rich(d.experience.team)} />
      </div>
      <div>
        <SectionHead eyebrow={d.experience.eyebrow} heading={d.experience.heading} />
        {d.experience.paragraphs.map((p: string) => <p set:html={rich(p)} />)}
        <ul class="tag-list about-exp__tags">{d.experience.areas.map((a: string) => <li>{a}</li>)}</ul>
        <p class="notice"><Icon name="shield" /><span set:html={rich(d.experience.notice)} /></p>
      </div>
    </div>
  </section>

  <section class="section" id="mission">
    <div class="container">
      <div class="mission">
        <p class="eyebrow">{d.mission.eyebrow}</p>
        <h2>{d.mission.heading}</h2>
        <p class="mission__statement" set:html={rich(d.mission.statement)} />
      </div>
      <h3 class="about-sub">{d.mission.valuesHeading}</h3>
      <FeatureGrid items={d.mission.values} columns={3} />
    </div>
  </section>

  <section class="section section--alt" id="divisions">
    <div class="container">
      <SectionHead eyebrow={d.divisions.eyebrow} heading={d.divisions.heading} />
      <div class="division-cards">
        {divisions.map((v: any, i: number) => (
          <article class:list={['division-card', i === 0 && 'division-card--primary']}>
            <p class="division-card__tag">{v.tag}</p>
            <h3>{v.title}</h3>
            <p set:html={rich(v.text)} />
            <ul class="check-list">{v.points.map((p: string) => <li><Icon name="check" />{p}</li>)}</ul>
            <a class="link-arrow" href={v.link.href}>{v.link.label}<Icon name="arrow-right" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="group">
    <div class="container split">
      <div>
        <SectionHead eyebrow={d.group.eyebrow} heading={d.group.heading} />
        <p class="lead" set:html={rich(d.group.text)} />
      </div>
      <p class="notice"><Icon name="shield" /><span set:html={rich(d.group.notice)} /></p>
    </div>
  </section>

  <CTABand heading={d.cta.heading} text={d.cta.text} buttons={d.cta.buttons} />
</BaseLayout>

<style>
  .about-exp__media { display: grid; gap: 1rem; }
  .about-exp__team { margin: 0; font-size: 0.875rem; }
  .about-exp__tags { margin: 1.5rem 0; }
  .mission { max-width: 860px; padding-left: 1.5rem; border-left: 4px solid var(--red-600); margin-bottom: 3rem; }
  .mission__statement { font-family: var(--font-display); font-stretch: var(--display-stretch); font-weight: 600; font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem); line-height: 1.35; color: var(--navy-700); margin: 0; }
  .about-sub { font-family: var(--font-mono); font-stretch: normal; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-500); margin-bottom: 1.25rem; }
</style>
